      // E. Education & Research
      RESUME_DATA.education.forEach(edu => {
        const pubText = edu.publication ? `${edu.publication.title} ${edu.publication.journal} ${edu.publication.authors}` : "";
        idx.push({
          title: `${edu.degree} (${edu.institution})`,
          subtitle: `${edu.dates} &bull; ${edu.description}`,
          icon: "🎓",
          cat: "Formation & Recherche",
          meta: edu.dates,
          keywords: `${edu.degree} ${edu.institution} ${edu.description} ${pubText}`,
          action: () => {
            switchMainView('web');
            filterByDomain('all');
          }
        });
      });

      // Attach synonyms indexer
      idx.forEach(item => {
        let kwLower = item.keywords.toLowerCase();
        for (const [key, synList] of Object.entries(SYNONYMS)) {
          if (kwLower.includes(key)) {
            kwLower += " " + synList.join(" ");
          }
        }
        item._normalizedKeywords = kwLower;
      });

      return idx;
    }

    // Levenshtein distance for typo tolerance
    function levenshteinDistance(s1, s2) {
      s1 = s1.toLowerCase();
      s2 = s2.toLowerCase();
      const costs = [];
      for (let i = 0; i <= s1.length; i++) {
        let lastValue = i;
        for (let j = 0; j <= s2.length; j++) {
          if (i === 0) costs[j] = j;
          else if (j > 0) {
            let newValue = costs[j - 1];
            if (s1.charAt(i - 1) !== s2.charAt(j - 1)) {
              newValue = Math.min(Math.min(newValue, lastValue), costs[j]) + 1;
            }
            costs[j - 1] = lastValue;
            lastValue = newValue;
          }
        }
        if (i > 0) costs[s2.length] = lastValue;
      }
      return costs[s2.length];
    }

    // 2. Smart Fuzzy Match & Scoring Function
    function performSmartSearch(query) {
      if (!query || !query.trim()) {
        return searchIndex.filter(i => i.cat === "Actions").slice(0, 8);
      }
      const rawQ = query.toLowerCase().trim();
      const qTokens = rawQ.split(/\s+/).filter(Boolean);

      const results = [];

      searchIndex.forEach(item => {
        const titleLower = item.title.toLowerCase();
        const kwLower = item._normalizedKeywords;
        const allText = `${titleLower} ${kwLower}`;
        let score = 0;

        // Exact match
        if (titleLower.includes(rawQ)) score += 100;
        if (kwLower.includes(rawQ)) score += 50;

        // Token match & Fuzzy match
        for (const t of qTokens) {
          if (titleLower.includes(t)) {
            score += 40;
          } else if (kwLower.includes(t)) {
            score += 20;
          } else if (t.length >= 3) {
            // Check fuzzy Levenshtein on all individual words
            const words = allText.split(/[\s\-_\/,\.:;()]+/);
            for (const w of words) {
              if (w.length >= 3) {
                if (w.startsWith(t) || t.startsWith(w)) {
                  score += 15;
                  break;
                }
                if (t.length >= 4 && w.length >= 4 && levenshteinDistance(t, w) <= 2) {
                  score += 10;
                  break;
                }
              }
            }
          }
        }

        if (score > 0) {
          if (item.cat === "Technologies" && titleLower.includes(rawQ)) score += 20;
          if (item.cat === "Expériences" && titleLower.includes(rawQ)) score += 15;
          results.push({ item, score });
        }
      });

      // Sort by highest score first
      results.sort((a, b) => b.score - a.score);
      return results.map(r => r.item);
    }

    // 3. Palette UI Functions (Using Native HTML5 Dialog)
    function openPalette() {
      if (searchIndex.length === 0) {
        searchIndex = buildSearchIndex();
      }
      const dialog = document.getElementById('cmdPaletteDialog');
      if (dialog) {
        if (!dialog.open) {
          dialog.showModal();
        }
        setTimeout(() => {
          const input = document.getElementById('paletteSearchInput');
          if (input) {
            input.value = '';
            input.focus();
          }
        }, 50);
        selectedPaletteIndex = 0;
        handlePaletteSearch('');
      }
    }

    function closePalette() {
      const dialog = document.getElementById('cmdPaletteDialog');
      if (dialog && dialog.open) {
        dialog.close();
      }
    }

    function handlePaletteSearch(val) {
      currentPaletteResults = performSmartSearch(val);
      selectedPaletteIndex = 0;
      renderPaletteResults(currentPaletteResults, val);
    }

    function highlightText(text, query) {
      if (!query || !text) return text;
      const q = query.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${q})`, 'gi');
      return text.replace(regex, '<mark>$1</mark>');
    }

    function renderPaletteResults(items, query) {
      const container = document.getElementById('paletteResults');
      container.innerHTML = '';

      if (items.length === 0) {
        container.innerHTML = `
          <div class="palette-empty">
            <p>Aucun résultat pour "<strong>${query}</strong>"</p>
            <p style="font-size:0.78rem; color:var(--text-dim); margin-top:0.3rem;">Essayez un des termes populaires ci-dessous :</p>
            <div class="palette-suggestions">
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('suckless')">🎮 suckless</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('rust-firework')">🎆 rust-firework</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('LLM')">🤖 LLM</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('Vulkan')">🌋 Vulkan</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('Python')">🐍 Python</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('FastAPI')">⚡ FastAPI</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('Docker')">🐳 Docker</span>
              <span class="tech-tag-item" style="padding:0.3rem 0.7rem; font-size:0.8rem;" onclick="setPaletteQuery('PostGIS')">🗺️ PostGIS</span>
            </div>
          </div>
        `;
        return;
      }

      // Group items by category
      const groups = {};
      items.forEach((it, idx) => {
        if (!groups[it.cat]) groups[it.cat] = [];
        groups[it.cat].push({ it, globalIdx: idx });
      });

      for (const [catName, list] of Object.entries(groups)) {
        const grpTitle = document.createElement('div');
        grpTitle.className = 'palette-group-header';
        grpTitle.innerText = `${catName} (${list.length})`;
        container.appendChild(grpTitle);

        list.forEach(({ it, globalIdx }) => {
          const div = document.createElement('div');
          div.className = 'palette-item' + (globalIdx === selectedPaletteIndex ? ' selected' : '');
          div.setAttribute('data-idx', globalIdx);
          div.innerHTML = `
            <div class="palette-item-left">
              <span class="palette-item-icon">${it.icon || '▸'}</span>
              <div class="palette-item-text">
                <div class="palette-item-title">${highlightText(it.title, query)}</div>
                ${it.subtitle ? `<div class="palette-item-desc">${highlightText(it.subtitle, query)}</div>` : ''}
              </div>
            </div>
            <span class="item-meta">${it.meta || ''}</span>
          `;
          div.onclick = () => {
            it.action();
            closePalette();
          };
          div.onmouseenter = () => {
            selectedPaletteIndex = globalIdx;
            updatePaletteSelection();
          };
          container.appendChild(div);
        });
      }
    }

    function setPaletteQuery(val) {
      const input = document.getElementById('paletteSearchInput');
      if (input) {
        input.value = val;
        handlePaletteSearch(val);
      }
    }

    function updatePaletteSelection() {
      const items = document.querySelectorAll('.palette-item');
      items.forEach(el => {
        const idx = parseInt(el.getAttribute('data-idx'));
        el.classList.toggle('selected', idx === selectedPaletteIndex);
        if (idx === selectedPaletteIndex) {
          el.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    // Keyboard navigation in palette, lightbox, and document
    document.addEventListener('keydown', (e) => {
      const imageDialog = document.getElementById('imageModalDialog');
      if (imageDialog && imageDialog.open) {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          prevLightboxImage();
          return;
        }
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextLightboxImage();
          return;
        }
        if (e.key === 'Escape') {
          e.preventDefault();
          closeImageModal();
          return;
        }
        return;
      }

      const dialog = document.getElementById('cmdPaletteDialog');
      const isPaletteOpen = dialog && dialog.open;

      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (isPaletteOpen) closePalette();
        else openPalette();
        return;
      }

      if (isPaletteOpen) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentPaletteResults.length > 0) {
            selectedPaletteIndex = (selectedPaletteIndex + 1) % currentPaletteResults.length;
            updatePaletteSelection();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentPaletteResults.length > 0) {
            selectedPaletteIndex = (selectedPaletteIndex - 1 + currentPaletteResults.length) % currentPaletteResults.length;
            updatePaletteSelection();
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (currentPaletteResults.length > 0 && currentPaletteResults[selectedPaletteIndex]) {
            currentPaletteResults[selectedPaletteIndex].action();
            closePalette();
          }
        }
        return;
      }

      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'v' || e.key === 'V') switchMainView(currentMainView === 'doc' ? 'web' : 'doc');
      if (e.key === 't' || e.key === 'T') toggleTheme();
      if (e.key === 'p' || e.key === 'P') {
        e.preventDefault();
        printResume();
      }

      // Page Navigation shortcuts in Document ISO view
      if (currentMainView === 'doc' && docMode === 'single') {
        if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
          e.preventDefault();
          prevDocPage();
        } else if (e.key === 'ArrowRight' || e.key === 'PageDown') {
          e.preventDefault();
          nextDocPage();
        }
      }
    });

    // 4. PDF.js ISO Renderer (On-Demand Lazy Loader)
    function ensurePdfJsLoaded() {
      if (typeof pdfjsLib !== 'undefined') return Promise.resolve();
      if (pdfJsLoadingPromise) return pdfJsLoadingPromise;

      pdfJsLoadingPromise = new Promise((resolve, reject) => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf_viewer.min.css';
        document.head.appendChild(link);

        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = () => {
          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          resolve();
        };
        script.onerror = reject;
        document.head.appendChild(script);
      });
      return pdfJsLoadingPromise;
    }

    async function loadPDF() {
      await ensurePdfJsLoaded();
      // Surge.sh blocks .pdf extension on free tier. Fallback chain: .dat binary -> direct .pdf -> GitHub Pages PROD
      const candidateUrls = [
        'assets/cv_master.pdf.dat',
        PDF_URL,
        `https://yoyonel.github.io/CV_resume/${PDF_URL}`
      ];
      let lastErr = null;
      for (const url of candidateUrls) {
        try {
          pdfDoc = await pdfjsLib.getDocument(url).promise;
          await renderDocPages();
          return;
        } catch (err) {
          lastErr = err;
        }
      }
      console.error('PDF.js loading failed on all endpoints', lastErr);
    }

    let renderTasks = {};
    let zoomDebounceTimer = null;

    async function renderDocPage(pageNum, canvasId, textLayerId) {
      if (!pdfDoc) return;
      const onScreenCanvas = document.getElementById(canvasId);
      if (!onScreenCanvas) return;
      const container = onScreenCanvas.closest('.pdf-page-container');
      if (container && (container.offsetParent === null || getComputedStyle(container).display === 'none')) return;

      if (renderTasks[pageNum]) {
        try { renderTasks[pageNum].cancel(); } catch (e) {}
      }

      const page = await pdfDoc.getPage(pageNum);
      const onScreenCtx = onScreenCanvas.getContext('2d');
      const textLayerDiv = document.getElementById(textLayerId);

      const unscaledViewport = page.getViewport({ scale: 1.0 });
      const isMobile = window.innerWidth <= 860;
      const vDoc = document.getElementById('viewDocument');
      const maxAvail = vDoc ? Math.max(280, vDoc.clientWidth - 32) : (window.innerWidth - 32);
      let baseWidth = 840;
      if (docMode === 'dual' && !isMobile) {
        baseWidth = Math.min(840, Math.max(340, Math.floor((maxAvail - 32) / 2)));
      } else if (isMobile) {
        baseWidth = Math.min(840, maxAvail);
      }
      const targetWidth = Math.round(baseWidth * docZoom);
      const scaleFactor = targetWidth / unscaledViewport.width;
      const viewport = page.getViewport({ scale: scaleFactor });

      const dpr = window.devicePixelRatio || 1;
      const bufferW = Math.floor(viewport.width * dpr);
      const bufferH = Math.floor(viewport.height * dpr);

      // --- DOUBLE BUFFERING (Offscreen Rendering) ---
      const offscreenCanvas = document.createElement('canvas');
      offscreenCanvas.width = bufferW;
      offscreenCanvas.height = bufferH;
      const offscreenCtx = offscreenCanvas.getContext('2d');

      const renderTask = page.render({
        canvasContext: offscreenCtx,
        viewport: viewport,
        transform: [dpr, 0, 0, dpr, 0, 0]
      });
      renderTasks[pageNum] = renderTask;

      try {
        await renderTask.promise;
      } catch (err) {
        if (err.name === 'RenderingCancelledException') return;
        console.error('Page render error', err);
        return;
      } finally {
        delete renderTasks[pageNum];
      }

      // --- ATOMIC BUFFER SWAP (Zero White Flash / Tearing) ---
      document.documentElement.style.setProperty('--scale-factor', String(viewport.scale));
      if (container) {
        container.style.width = Math.floor(viewport.width) + 'px';
        container.style.height = Math.floor(viewport.height) + 'px';
        container.style.maxWidth = 'none';
        container.style.setProperty('--scale-factor', String(viewport.scale));
      }

      onScreenCanvas.width = bufferW;
      onScreenCanvas.height = bufferH;
      onScreenCtx.drawImage(offscreenCanvas, 0, 0);

      if (textLayerDiv) {
        if (container && (container.offsetParent === null || getComputedStyle(container).display === 'none')) return;
        if (currentMainView !== 'doc') return;
        textLayerDiv.innerHTML = '';
        textLayerDiv.style.width = Math.floor(viewport.width) + 'px';
        textLayerDiv.style.height = Math.floor(viewport.height) + 'px';
        textLayerDiv.style.setProperty('--scale-factor', String(viewport.scale));
        const textContent = await page.getTextContent();
        if (container && (container.offsetParent === null || getComputedStyle(container).display === 'none')) return;
        if (currentMainView !== 'doc' || getComputedStyle(textLayerDiv).display === 'none') return;
        textLayerDiv.style.setProperty('--scale-factor', String(viewport.scale));
        try {
          pdfjsLib.renderTextLayer({
            textContentSource: textContent,
            container: textLayerDiv,
            viewport: viewport,
            textDivs: []
          });
        } catch (_) {}
      }
    }

    async function renderDocPages() {
      const vDoc = document.getElementById('viewDocument');
      if (vDoc && (vDoc.style.display === 'none' || getComputedStyle(vDoc).display === 'none')) {
        return;
      }
      if (docMode === 'single') {
        if (docPageNum === 1) {
          await renderDocPage(1, 'canvasPage1', 'textLayer1');
        } else {
          await renderDocPage(2, 'canvasPage2', 'textLayer2');
        }
      } else {
        await Promise.all([
          renderDocPage(1, 'canvasPage1', 'textLayer1'),
          renderDocPage(2, 'canvasPage2', 'textLayer2')
        ]);
      }
    }

    function setDocMode(mode) {
      docMode = mode;
      const wrapper = document.getElementById('pagesWrapper');
      wrapper.className = 'pages-wrapper mode-' + mode;

      const btnSingle = document.getElementById('btnModeSingle');
      const btnDual = document.getElementById('btnModeDual');
      const btnContinuous = document.getElementById('btnModeContinuous');

      [btnSingle, btnDual, btnContinuous].forEach(b => {
        if (b) b.classList.remove('active', 'btn-primary');
      });

      if (mode === 'single' && btnSingle) btnSingle.classList.add('active', 'btn-primary');
      if (mode === 'dual' && btnDual) btnDual.classList.add('active', 'btn-primary');
      if (mode === 'continuous' && btnContinuous) btnContinuous.classList.add('active', 'btn-primary');

      const pageNav = document.getElementById('singlePageNav');
      if (pageNav) {
        pageNav.style.display = mode === 'single' ? 'inline-flex' : 'none';
      }

      if (mode === 'single') {
        updateDocSingle();
      } else {
        document.getElementById('pageContainer1').classList.add('active');
        document.getElementById('pageContainer2').classList.add('active');
        renderDocPages();
      }
    }

    function prevDocPage() {
      if (docPageNum > 1) {
        docPageNum = 1;
        updateDocSingle();
      }
    }

    function nextDocPage() {
      if (docPageNum < 2) {
        docPageNum = 2;
        updateDocSingle();
      }
    }

    function toggleDocSingle() {
      if (docPageNum === 1) nextDocPage();
      else prevDocPage();
    }

    function updateDocSingle() {
      document.getElementById('pageContainer1').classList.toggle('active', docPageNum === 1);
      document.getElementById('pageContainer2').classList.toggle('active', docPageNum === 2);
      document.getElementById('lblPageNum').innerText = `Page ${docPageNum} / 2`;

      const btnPrev = document.getElementById('btnPrevPage');
      const btnNext = document.getElementById('btnNextPage');
      if (btnPrev) btnPrev.disabled = (docPageNum === 1);
      if (btnNext) btnNext.disabled = (docPageNum === 2);

      renderDocPages();
    }

    function zoomDoc(delta) {
      docZoom = Math.min(Math.max(0.5, docZoom + delta), 2.5);
      document.getElementById('lblZoom').innerText = `${Math.round(docZoom * 100)}%`;
      clearTimeout(zoomDebounceTimer);
      zoomDebounceTimer = setTimeout(() => {
        renderDocPages();
      }, 20);
    }

    // 5. View Switcher (Document ↔ Interactive Web)
    function switchMainView(view) {
      currentMainView = view;
      document.body.setAttribute('data-view', view);
      const vDoc = document.getElementById('viewDocument');
      const vWeb = document.getElementById('viewInteractive');
      const tabDoc = document.getElementById('tabDoc');
      const tabWeb = document.getElementById('tabWeb');

      if (view === 'doc') {
        vDoc.style.display = 'flex';
        vWeb.style.display = 'none';
        if (tabDoc) {
          tabDoc.classList.add('active', 'btn-primary');
          tabDoc.classList.remove('btn-default');
        }
        if (tabWeb) {
          tabWeb.classList.remove('active', 'btn-primary');
          tabWeb.classList.add('btn-default');
        }
        if (!pdfDoc) {
          loadPDF();
        }
      } else {
        vDoc.style.display = 'none';
        vWeb.style.display = 'block';
        if (tabDoc) {
          tabDoc.classList.remove('active', 'btn-primary');
          tabDoc.classList.add('btn-default');
        }
        if (tabWeb) {
          tabWeb.classList.add('active', 'btn-primary');
          tabWeb.classList.remove('btn-default');
        }
      }
    }

    function goToMediaSection() {
      switchMainView('web');
      filterByDomain('all');
      setTimeout(() => {
        const el = document.getElementById('section-projects');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }

    // 6. Domain & Tech Filtering (Support Normal Click + Shift/Ctrl Multi-Selection)
    function filterByDomain(domain, event) {
      const e = event || window.event;
      const isMulti = e && (e.shiftKey || e.ctrlKey || e.metaKey);

      if (domain === 'all') {
        activeDomains = new Set(['all']);
      } else if (isMulti) {
        if (activeDomains.has('all')) {
          activeDomains.clear();
        }
        if (activeDomains.has(domain)) {
          activeDomains.delete(domain);
          if (activeDomains.size === 0) {
            activeDomains.add('all');
          }
        } else {
          activeDomains.add(domain);
        }
      } else {
        // Normal click: if already sole active domain, toggle back to 'all'
        if (activeDomains.size === 1 && activeDomains.has(domain)) {
          activeDomains = new Set(['all']);
        } else {
          activeDomains = new Set([domain]);
        }
      }

      // Update domain filter buttons UI
      const isAll = activeDomains.has('all');
      document.querySelectorAll('.filter-tag').forEach(c => {
        const d = c.getAttribute('data-domain');
        const match = isAll ? (d === 'all') : activeDomains.has(d);
        c.classList.toggle('active', match);
      });

      if (currentMainView !== 'web') {
        switchMainView('web');
      }

      document.querySelectorAll('.exp-wrapper').forEach(card => {
        const domains = (card.getAttribute('data-domains') || card.getAttribute('data-domain') || '').split(',');
        const match = isAll || domains.some(d => activeDomains.has(d));
        card.style.display = match ? 'block' : 'none';
      });

      document.querySelectorAll('.project-wrapper').forEach(card => {
        const domains = (card.getAttribute('data-domains') || card.getAttribute('data-domain') || '').split(',');
        const match = isAll || domains.some(d => activeDomains.has(d));
        card.style.display = match ? 'block' : 'none';
      });

      document.querySelectorAll('.skill-wrapper').forEach(card => {
        const d = card.getAttribute('data-domain');
        const match = isAll || activeDomains.has(d);
        card.style.display = match ? 'block' : 'none';
      });
    }

    function filterByTech(techName, event) {
      if (currentMainView !== 'web') {
        switchMainView('web');
      }
      const e = event || window.event;
      const isMulti = e && (e.shiftKey || e.ctrlKey || e.metaKey);
      const lower = techName.toLowerCase().trim();

      if (isMulti) {
        if (activeTechs.has(lower)) {
          activeTechs.delete(lower);
        } else {
          activeTechs.add(lower);
        }
      } else {
        if (activeTechs.size === 1 && activeTechs.has(lower)) {
          activeTechs.clear();
        } else {
          activeTechs = new Set([lower]);
        }
      }

      const hasActiveTech = activeTechs.size > 0;
      document.querySelectorAll('.tech-tag-item, .tech-kw').forEach(t => {
        const match = activeTechs.has(t.innerText.toLowerCase().trim());
        t.classList.toggle('active', match);
      });

      let firstMatch = null;
      document.querySelectorAll('.wa-exp-card, .wa-project-card').forEach(card => {
        if (!hasActiveTech) {
          card.classList.remove('highlight');
        } else {
          const textContent = card.innerText.toLowerCase();
          const matchesAny = Array.from(activeTechs).some(tech => textContent.includes(tech));
          card.classList.toggle('highlight', matchesAny);
          if (matchesAny && !firstMatch) {
            firstMatch = card;
          }
        }
      });

      if (firstMatch) {
        firstMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // 7. Media & Image Modals (Native HTML5 Dialogs)
    function openMediaModal(url, title) {
      const dialog = document.getElementById('mediaModalDialog');
      const titleEl = document.getElementById('mediaModalTitle');
      if (titleEl) titleEl.innerText = title || 'Aperçu Multimédia';
      document.getElementById('mediaModalFrame').src = url;
      if (dialog && !dialog.open) {
        dialog.showModal();
      }
    }

    function openMediaModalByElem(el) {
      const url = el.getAttribute('data-video-url');
      const title = el.getAttribute('data-title');
      openMediaModal(url, title);
    }

    function closeMediaModal() {
      const dialog = document.getElementById('mediaModalDialog');
      if (dialog && dialog.open) {
        dialog.close();
      }
      document.getElementById('mediaModalFrame').src = '';
    }

    let currentLightboxCardIdx = null;
    let currentLightboxGallery = [];
    let currentLightboxIndex = 0;

    function openImageModal(src, title, cardIdx) {
      const dialog = document.getElementById('imageModalDialog');
      currentLightboxCardIdx = cardIdx;
      currentLightboxGallery = [];
      currentLightboxIndex = 0;

      // Extract all gallery options from project card thumbnail buttons if available
      if (cardIdx) {
        const buttons = document.querySelectorAll(`.media-thumb-btn-${cardIdx}`);
        if (buttons.length > 0) {
          buttons.forEach((b, idx) => {
            const itemSrc = b.getAttribute('data-src');
            const itemLabel = b.getAttribute('data-label') || title || `Vue ${idx + 1}`;
            currentLightboxGallery.push({ src: itemSrc, label: itemLabel, btn: b });
            if (itemSrc === src) {
              currentLightboxIndex = idx;
            }
          });
        }
      }

      if (currentLightboxGallery.length === 0) {
        currentLightboxGallery.push({ src: src, label: title || 'Aperçu Grand Format', btn: null });
        currentLightboxIndex = 0;
      }

      updateLightboxView();

      if (dialog && !dialog.open) {
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      }
    }

    function updateLightboxView() {
      const img = document.getElementById('imageModalImg');
      const caption = document.getElementById('imageModalCaption');
      const prevBtn = document.getElementById('lightboxPrevBtn');
      const nextBtn = document.getElementById('lightboxNextBtn');
      const thumbsBox = document.getElementById('lightboxThumbs');

      const item = currentLightboxGallery[currentLightboxIndex];
      if (!item) return;

      if (img) {
        img.src = item.src;
        img.alt = item.label;
      }

      const hasMultiple = currentLightboxGallery.length > 1;
      if (prevBtn) prevBtn.style.display = hasMultiple ? 'flex' : 'none';
      if (nextBtn) nextBtn.style.display = hasMultiple ? 'flex' : 'none';

      if (caption) {
        if (hasMultiple) {
          caption.innerHTML = `<span>${item.label}</span> <span class="lightbox-counter">${currentLightboxIndex + 1} / ${currentLightboxGallery.length}</span>`;
          caption.style.display = 'flex';
        } else {
          caption.innerHTML = `<span>${item.label}</span>`;
          caption.style.display = item.label ? 'flex' : 'none';
        }
      }

      if (thumbsBox) {
        if (hasMultiple) {
          thumbsBox.innerHTML = '';
          thumbsBox.style.display = 'flex';
          currentLightboxGallery.forEach((it, idx) => {
            const thumbBtn = document.createElement('button');
            thumbBtn.type = 'button';
            thumbBtn.className = 'lightbox-thumb-pill' + (idx === currentLightboxIndex ? ' active' : '');
            thumbBtn.innerText = it.label;
            thumbBtn.onclick = (e) => {
              e.stopPropagation();
              setLightboxIndex(idx);
            };
            thumbsBox.appendChild(thumbBtn);
          });
        } else {
          thumbsBox.style.display = 'none';
        }
      }

      // Sync background project card active thumbnail button
      if (currentLightboxCardIdx && item.btn) {
        switchCardMedia(currentLightboxCardIdx, item.src, item.label, item.btn);
      }
    }

    function setLightboxIndex(newIdx) {
      if (currentLightboxGallery.length <= 1) return;
      currentLightboxIndex = (newIdx + currentLightboxGallery.length) % currentLightboxGallery.length;
      updateLightboxView();
    }

    function prevLightboxImage(event) {
      if (event) event.stopPropagation();
      setLightboxIndex(currentLightboxIndex - 1);
    }

    function nextLightboxImage(event) {
      if (event) event.stopPropagation();
      setLightboxIndex(currentLightboxIndex + 1);
    }

    function openImageModalByElem(el) {
      const cardIdx = el.getAttribute('data-card-idx');
      const title = el.getAttribute('data-title');
      const img = document.getElementById(`media-img-${cardIdx}`);
      if (img) {
        openImageModal(img.src, title, cardIdx);
      }
    }

    function closeImageModal() {
      const dialog = document.getElementById('imageModalDialog');
      if (dialog && dialog.open) {
        dialog.close();
      }
    }

    function switchCardMedia(cardIdx, src, label, btn) {
      const img = document.getElementById(`media-img-${cardIdx}`);
      const badge = document.getElementById(`media-badge-${cardIdx}`);
      if (img) img.src = src;
      if (badge) badge.innerText = src.endsWith('.gif') ? '🔥 DÉMO ANIMÉE' : '📸 ' + label.toUpperCase();

      if (btn) {
        const parent = btn.parentElement;
        if (parent) {
          parent.querySelectorAll(`.media-thumb-btn-${cardIdx}`).forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-default');
          });
          btn.classList.remove('btn-default');
          btn.classList.add('btn-primary');
        }
      }
    }

    function switchCardMediaByElem(btn) {
      const cardIdx = btn.getAttribute('data-card-idx');
      const src = btn.getAttribute('data-src');
      const label = btn.getAttribute('data-label') || '';
      switchCardMedia(cardIdx, src, label, btn);
    }

    // 8. Theme Management (prefers-color-scheme with localStorage override)
    function getPreferredTheme() {
      const saved = localStorage.getItem('cv_theme');
      if (saved === 'light' || saved === 'dark') return saved;
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        return 'light';
      }
      return 'dark';
    }

    function applyTheme(theme) {
      const html = document.documentElement;
      const iconUse = document.getElementById('themeIconUse');
      const btn = document.getElementById('themeToggleBtn');
      if (theme === 'light') {
        html.classList.remove('dark');
        html.classList.add('light');
        if (iconUse) iconUse.setAttribute('href', '#icon-sun');
        if (btn) {
          btn.setAttribute('data-tooltip', 'Passer en mode sombre (T)');
          btn.setAttribute('aria-label', 'Passer en mode sombre');
        }
      } else {
        html.classList.remove('light');
        html.classList.add('dark');
        if (iconUse) iconUse.setAttribute('href', '#icon-moon');
        if (btn) {
          btn.setAttribute('data-tooltip', 'Passer en mode clair (T)');
          btn.setAttribute('aria-label', 'Passer en mode clair');
        }
      }
    }

    function toggleTheme() {
      const current = document.documentElement.classList.contains('light') ? 'light' : 'dark';
      const newTheme = (current === 'light') ? 'dark' : 'light';
      applyTheme(newTheme);
      localStorage.setItem('cv_theme', newTheme);
    }

    // Resize handler for responsive PDF scaling
    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (currentMainView === 'doc' && pdfDoc) {
          renderDocPages();
        }
      }, 150);
    });

    // Preload & decode vector SVG pages for print
    async function preloadPrintPages() {
      const imgs = Array.from(document.querySelectorAll('.print-vector-page'));
      await Promise.all(imgs.map(async img => {
        if (!img.src) return;
        img.loading = 'eager';
        if ('decode' in img) {
          try {
            await img.decode();
          } catch (_) {}
        }
        if (!img.complete || img.naturalWidth === 0) {
          await new Promise(resolve => {
            img.addEventListener('load', resolve, { once: true });
            img.addEventListener('error', resolve, { once: true });
            setTimeout(resolve, 2000);
          });
        }
      }));
    }

    // Print handler: ensure both vector pages are fully loaded and decoded before triggering print dialog
    async function printResume() {
      const btn = document.querySelector('.btn-print');
      if (btn) btn.style.opacity = '0.6';
      try {
        await preloadPrintPages();
      } finally {
        if (btn) btn.style.opacity = '';
      }
      window.print();
    }

    // Print event listeners: preload print images when triggered via Ctrl+P / Cmd+P
    window.addEventListener('beforeprint', () => {
      document.querySelectorAll('.print-vector-page').forEach(img => {
        img.loading = 'eager';
      });
    });

    window.addEventListener('afterprint', () => {
      if (currentMainView === 'doc') {
        if (docMode === 'single') {
          updateDocSingle();
        } else {
          renderDocPages();
        }
      }
    });

    // Init
    function init() {
      applyTheme(getPreferredTheme());
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
          if (!localStorage.getItem('cv_theme')) {
            applyTheme(e.matches ? 'dark' : 'light');
          }
        });
      }
      if (window.location.hostname.endsWith('surge.sh')) {
        document.querySelectorAll('.btn-download').forEach(btn => {
          btn.setAttribute('href', `https://yoyonel.github.io/CV_resume/${PDF_URL}`);
        });
      }

      // Dialog lifecycle & backdrop click handling
      document.querySelectorAll('dialog').forEach(d => {
        d.addEventListener('close', () => {
          document.body.style.overflow = '';
          if (d.id === 'imageModalDialog') {
            const img = document.getElementById('imageModalImg');
            if (img) img.src = '';
          } else if (d.id === 'mediaModalDialog') {
            const frame = document.getElementById('mediaModalFrame');
            if (frame) frame.src = '';
          }
        });

        d.addEventListener('click', e => {
          const rect = d.getBoundingClientRect();
          const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height && rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
          if (!isInDialog) d.close();
        });
      });

      switchMainView('web');
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => { searchIndex = buildSearchIndex(); });
      } else {
        setTimeout(() => { searchIndex = buildSearchIndex(); }, 100);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
