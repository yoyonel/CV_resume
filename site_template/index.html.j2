            {% if proj.media.gallery %}
            <div class="media-gallery-thumbs">
              {% for g in proj.media.gallery %}
              <button class="media-thumb-btn {{ 'active' if loop.first else '' }}" onclick="switchCardMedia('{{ proj_idx }}', '{{ g.src }}', '{{ g.label }}', this)">
                {{ g.label }}
              </button>
              {% endfor %}
            </div>
            {% endif %}
            {% endif %}
          </div>
          {% endif %}
        </div>

        <div>
          <div class="tags-container" style="margin-bottom:0.75rem;">
            {% for t in proj.tags %}
            <span class="tech-tag" onclick="filterByTech('{{ t }}')">{{ t }}</span>
