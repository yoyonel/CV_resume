<!DOCTYPE html>
<html lang="fr" class="sl-theme-dark dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ profile.name }} — CV Senior Développeur & Architecte (Web Awesome & Typst)</title>
  <meta name="description" content="CV & Portfolio interactif de {{ profile.name }} — {{ profile.title }} ({{ profile.specialties }}). Composants Web Awesome et Rendu ISO Typst.">
  <meta name="author" content="{{ profile.name }}">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ profile.name }} — CV {{ profile.title }}">
  <meta property="og:description" content="{{ profile.title }} — {{ profile.specialties }}.">
  <meta property="og:image" content="assets/cv-page-1.png">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">

  <!-- Self-Hosted Zero-Latency Fonts -->
  <link rel="stylesheet" href="assets/fonts/fonts.css" />

  <!-- Web Awesome / Shoelace Web Components -->
  <link rel="stylesheet" href="assets/vendor/shoelace/dark.css" />
  <link rel="stylesheet" href="assets/vendor/shoelace/light.css" media="(prefers-color-scheme: light)" />
  <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/shoelace-autoloader.js"></script>

  <style>
    :root {
      --sl-color-primary-50: #f0f9ff;
      --sl-color-primary-100: #e0f2fe;
      --sl-color-primary-200: #bae6fd;
      --sl-color-primary-300: #7dd3fc;
      --sl-color-primary-400: #38bdf8;
      --sl-color-primary-500: #0ea5e9;
      --sl-color-primary-600: #0284c7;
      --sl-color-primary-700: #0369a1;
      --sl-color-primary-800: #075985;
      --sl-color-primary-900: #0c4a6e;
      --sl-color-primary-950: #082f49;

      --bg-canvas: #090d16;
      --bg-ambient: radial-gradient(circle at 50% -20%, rgba(56, 189, 248, 0.12) 0%, transparent 60%);
      --bg-header: rgba(9, 13, 22, 0.88);
      --bg-card: #111827;
      --bg-card-hover: #172136;
      --bg-card-subtle: #0d1320;
      --border-color: rgba(255, 255, 255, 0.08);
      --border-focus: rgba(56, 189, 248, 0.4);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --accent: #38bdf8;
      --accent-gradient: linear-gradient(135deg, #38bdf8 0%, #2563eb 100%);
      --accent-glow: rgba(56, 189, 248, 0.25);
      --paper-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.1);
      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;
      --header-height: 60px;
    }

    html.sl-theme-light {
      --bg-canvas: #f8fafc;
      --bg-ambient: radial-gradient(circle at 50% -20%, rgba(2, 132, 199, 0.08) 0%, transparent 60%);
      --bg-header: rgba(255, 255, 255, 0.92);
      --bg-card: #ffffff;
      --bg-card-hover: #f1f5f9;
      --bg-card-subtle: #f8fafc;
      --border-color: rgba(0, 0, 0, 0.08);
      --border-focus: rgba(2, 132, 199, 0.4);
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-dim: #94a3b8;
      --accent: #0284c7;
      --accent-gradient: linear-gradient(135deg, #0284c7 0%, #1d4ed8 100%);
      --accent-glow: rgba(2, 132, 199, 0.2);
      --paper-shadow: 0 15px 40px -10px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(15, 23, 42, 0.06);
    }

    :not(:defined) {
      visibility: hidden;
    }

    sl-avatar::part(base) {
      background-color: #0369a1;
      color: #ffffff;
    }
    sl-avatar::part(initials) {
      color: #ffffff;
      font-weight: 700;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: var(--bg-canvas);
      background-image: var(--bg-ambient);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Fixed Glass Navbar */
    header.top-header {
      position: sticky;
      top: 0;
      z-index: 100;
      height: var(--header-height);
      min-height: var(--header-height);
      background: var(--bg-header);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      gap: 1rem;
      box-sizing: border-box;
      max-width: 100vw;
      width: 100%;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 220px;
    }

    .brand-meta h1 {
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.1;
      color: var(--text-main);
    }

    .brand-meta p {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Web Awesome Customization for Navbar */
    .view-switcher-group {
      display: flex;
      align-items: center;
    }

    .actions-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Sub-bar / Filters & Quick Links */
    .filter-bar {
      position: sticky;
      top: var(--header-height);
      z-index: 90;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      height: 52px;
      min-height: 52px;
      max-height: 52px;
      box-sizing: border-box;
      background: rgba(9, 13, 22, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      font-size: 0.78rem;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 1rem;
      max-width: 100vw;
      width: 100%;
    }
    .filter-bar::-webkit-scrollbar {
      display: none;
    }
    html.sl-theme-light .filter-bar {
      background: rgba(248, 250, 252, 0.85);
    }

    .domain-filters {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: nowrap;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .filter-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.3rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 500;
      line-height: 1.3;
      background: var(--sl-color-neutral-100, #f4f4f5);
      color: var(--sl-color-neutral-800, #27272a);
      border: 1px solid var(--sl-color-neutral-300, #e4e4e7);
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s ease-in-out;
      user-select: none;
    }
    .dark .filter-tag {
      background: rgba(255, 255, 255, 0.07);
      color: var(--sl-color-neutral-200, #e4e4e7);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .filter-tag.active {
      background: var(--sl-color-primary-600, #0284c7) !important;
      color: #ffffff !important;
      border-color: var(--sl-color-primary-600, #0284c7) !important;
      box-shadow: 0 2px 8px rgba(2, 132, 199, 0.35);
    }
    .filter-tag:hover:not(.active) {
      background: rgba(2, 132, 199, 0.15);
      border-color: var(--sl-color-primary-500, #0ea5e9);
      color: var(--sl-color-primary-400, #38bdf8);
    }

    .contact-chips {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: nowrap;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .contact-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.25rem 0.65rem;
      border-radius: var(--sl-border-radius-medium, 0.25rem);
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1.3;
      background: var(--sl-color-neutral-100, #f4f4f5);
      color: var(--text-muted, #71717a);
      border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.08));
      text-decoration: none;
      transition: all 0.15s ease-in-out;
    }
    .dark .contact-chip {
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-dim, #a1a1aa);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .contact-chip:hover {
      background: var(--sl-color-primary-600, #0284c7);
      color: #ffffff;
      border-color: var(--sl-color-primary-600, #0284c7);
    }
    .contact-chip a {
      color: inherit;
      text-decoration: none;
    }

    /* ========================================================
       VIEW 1: DOCUMENT ISO PDF
       ======================================================== */
    #viewDocument {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1.5rem 1rem 3.5rem;
      min-height: calc(100vh - 120px);
      width: 100%;
      box-sizing: border-box;
    }

    .doc-controls {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
      min-height: 36px;
    }

    .pages-wrapper {
      display: flex;
      gap: 2rem;
      justify-content: center;
      align-items: center;
      transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.4, 1);
      transform-origin: top center;
      min-height: 1188px;
      width: 100%;
    }

    .pages-wrapper.mode-dual {
      flex-direction: row;
      justify-content: center;
      align-items: center;
    }

    .pages-wrapper.mode-continuous {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2.5rem;
    }

    .pages-wrapper.mode-single .pdf-page-container {
      display: none;
    }
    .pages-wrapper.mode-single .pdf-page-container.active {
      display: block;
    }

    .pdf-page-container {
      position: relative;
      background: #ffffff;
      border-radius: 4px;
      box-shadow: var(--paper-shadow);
      line-height: 0;
      width: 840px;
      max-width: 100%;
      height: 1188px;
      aspect-ratio: 1 / 1.4142;
      overflow: hidden;
      box-sizing: border-box;
      margin: 0 auto;
    }

    .pdf-page-container canvas {
      display: block;
      border-radius: 4px;
      width: 100% !important;
      height: 100% !important;
      aspect-ratio: 1 / 1.4142;
    }

    .pdf-page-container .textLayer {
      opacity: 0.95;
      mix-blend-mode: multiply;
      border-radius: 4px;
    }

    .page-tag {
      position: absolute;
      top: -20px;
      left: 0;
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--text-dim);
      font-family: 'JetBrains Mono', monospace;
    }

    /* ========================================================
       VIEW 2: INTERACTIVE PORTFOLIO & WEB APP
       ======================================================== */
    #viewInteractive {
      display: none;
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem 5rem;
      width: 100%;
    }

    /* Hero / Summary Banner (Web Awesome Card) */
    .hero-card {
      margin-bottom: 2.5rem;
      width: 100%;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      padding: 1.5rem;
      box-sizing: border-box;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2rem;
      align-items: center;
    }

    .hero-title h2 {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.35rem;
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-title p {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .hero-stats {
      display: flex;
      gap: 1.5rem;
    }

    .stat-box {
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-color);
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-md);
      text-align: center;
    }

    .stat-number {
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--accent);
      font-family: 'JetBrains Mono', monospace;
    }

    .stat-label {
      font-size: 0.72rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Section Headers */
    .section-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 3rem 0 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.65rem;
      color: var(--text-main);
    }

    .section-title::before {
      content: '';
      display: inline-block;
      width: 14px;
      height: 4px;
      background: var(--accent);
      border-radius: 2px;
    }

    /* Connected Timeline Cards (Web Awesome Cards) */
    .timeline-container {
      position: relative;
      padding-left: 2rem;
    }

    .timeline-container::before {
      content: '';
      position: absolute;
      left: 7px;
      top: 15px;
      bottom: 20px;
      width: 2px;
      background: var(--border-color);
    }

    .wa-exp-card {
      display: block;
      margin-bottom: 1.75rem;
      width: 100%;
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      padding: 1.35rem;
      box-sizing: border-box;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .wa-exp-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-focus);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .wa-exp-card.highlight {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
      animation: pulseHighlight 1.5s infinite alternate;
    }

    @keyframes pulseHighlight {
      0% { box-shadow: 0 0 0 2px var(--accent); }
      100% { box-shadow: 0 0 0 6px var(--accent-glow); }
    }

    .exp-node {
      position: absolute;
      left: -2rem;
      top: 1.6rem;
      transform: translateX(-50%);
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent);
      border: 3px solid var(--bg-canvas);
      box-shadow: 0 0 8px var(--accent-glow);
      z-index: 2;
    }

    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .exp-role {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .exp-company {
      color: var(--accent);
      font-weight: 700;
    }

    .exp-summary {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      line-height: 1.5;
      font-style: italic;
    }

    .exp-bullets {
      list-style: none;
      margin-bottom: 1.25rem;
    }

    .exp-bullets li {
      position: relative;
      padding-left: 1.25rem;
      margin-bottom: 0.5rem;
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--text-main);
    }

    .exp-bullets li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    /* Architecture Interactive Pipeline */
    .pipeline-box {
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .pipeline-label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-dim);
      margin-right: 0.5rem;
    }

    .pipeline-step {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 0.3rem 0.65rem;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-main);
      transition: all 0.15s ease;
    }

    .pipeline-step:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: scale(1.03);
    }

    .pipeline-arrow {
      color: var(--accent);
      font-weight: bold;
    }

    /* Tags Palette */
    .tags-container {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .tech-tag-item {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      font-size: 0.73rem;
      font-weight: 500;
      line-height: 1.3;
      font-family: 'JetBrains Mono', monospace;
      background: var(--sl-color-neutral-100, #f4f4f5);
      color: var(--sl-color-neutral-800, #27272a);
      border: 1px solid var(--sl-color-neutral-300, #e4e4e7);
      cursor: pointer;
      transition: all 0.15s ease-in-out;
      user-select: none;
      text-decoration: none;
    }
    .dark .tech-tag-item {
      background: rgba(255, 255, 255, 0.07);
      color: var(--sl-color-neutral-200, #e4e4e7);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .tech-tag-item.active {
      background: var(--sl-color-primary-600, #0284c7) !important;
      color: #ffffff !important;
      border-color: var(--sl-color-primary-600, #0284c7) !important;
    }
    .tech-tag-item:hover:not(.active) {
      background: var(--sl-color-primary-600, #0284c7);
      color: #ffffff;
      border-color: var(--sl-color-primary-600, #0284c7);
      transform: translateY(-1px);
    }

    /* Projects Grid with Web Awesome Cards & Carousel */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
      gap: 1.5rem;
      margin-bottom: 2.5rem;
    }

    .project-wrapper,
    .skill-wrapper,
    .exp-wrapper {
      min-width: 0;
      max-width: 100%;
    }

    .wa-project-card,
    .wa-skill-card,
    .wa-exp-card {
      min-width: 0;
      max-width: 100%;
    }

    .wa-project-card {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      padding: 1.35rem;
      box-sizing: border-box;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .wa-project-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-focus);
      box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.4);
    }

    .wa-project-card.highlight {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
      animation: pulseHighlight 1.5s infinite alternate;
    }

    .project-category {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.4rem;
    }

    .project-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    .project-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 1rem;
    }

    /* Media Box & Visual Showcase */
    .project-media-box {
      position: relative;
      margin: 0.85rem 0 1.15rem;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border-color);
      background: #000;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      max-width: 100%;
    }

    .project-media-main {
      position: relative;
      width: 100%;
      height: 200px;
      overflow: hidden;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #060911;
    }

    .project-media-main img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .project-media-main:hover img {
      transform: scale(1.03);
    }

    .media-badge-overlay {
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(4px);
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--accent);
      border: 1px solid var(--border-focus);
      font-family: 'JetBrains Mono', monospace;
      z-index: 2;
    }

    .media-zoom-overlay {
      position: absolute;
      bottom: 8px;
      right: 8px;
      background: rgba(0, 0, 0, 0.75);
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      font-size: 0.68rem;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      z-index: 2;
    }

    .video-play-btn {
      position: absolute;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--accent-gradient);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.2rem;
      box-shadow: 0 0 20px var(--accent-glow);
      transition: transform 0.2s ease;
      z-index: 2;
    }

    .project-media-main:hover .video-play-btn {
      transform: scale(1.15);
    }

    .media-gallery-thumbs {
      display: flex;
      gap: 0.35rem;
      padding: 0.4rem;
      background: var(--bg-card-subtle);
      border-top: 1px solid var(--border-color);
      overflow-x: auto;
      max-width: 100%;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .media-gallery-thumbs::-webkit-scrollbar {
      display: none;
    }

    /* Skills Categorized Grid */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .wa-skill-card {
      width: 100%;
      height: 100%;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
      padding: 1.25rem;
      box-sizing: border-box;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .wa-skill-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-focus);
      box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.35);
    }

    .wa-skill-card.highlight {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--accent);
    }

    .skill-card-title {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.85rem;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ========================================================
       SMART COMMAND PALETTE (CTRL + K with Web Awesome Dialog)
       ======================================================== */
    .cmd-palette-dialog::part(panel) {
      background: var(--bg-card);
      border: 1px solid var(--border-focus);
      border-radius: var(--radius-lg);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.85);
      max-width: 650px;
      width: 92vw;
      overflow: hidden;
      padding: 0;
    }

    .cmd-palette-dialog::part(body) {
      padding: 0;
    }

    .palette-header-box {
      padding: 1rem 1.25rem;
      background: var(--bg-card-subtle);
      border-bottom: 1px solid var(--border-color);
    }

    .palette-results {
      max-height: 400px;
      overflow-y: auto;
      padding: 0.5rem;
    }

    .palette-group-header {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-dim);
      padding: 0.6rem 0.75rem 0.25rem;
    }

    .palette-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      color: var(--text-main);
      font-size: 0.85rem;
      transition: all 0.1s ease;
      gap: 0.75rem;
    }

    .palette-item:hover, .palette-item.selected {
      background: var(--accent);
      color: #fff;
    }

    .palette-item-left {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      overflow: hidden;
    }

    .palette-item-icon {
      font-size: 1rem;
      line-height: 1;
    }

    .palette-item-text {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .palette-item-title {
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .palette-item-desc {
      font-size: 0.72rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .palette-item:hover .palette-item-desc, .palette-item.selected .palette-item-desc {
      color: rgba(255, 255, 255, 0.85);
    }

    .palette-item .item-meta {
      font-size: 0.7rem;
      color: var(--text-dim);
      font-family: 'JetBrains Mono', monospace;
      white-space: nowrap;
    }
    .palette-item:hover .item-meta, .palette-item.selected .item-meta {
      color: rgba(255, 255, 255, 0.9);
    }

    .palette-item mark {
      background: rgba(56, 189, 248, 0.35);
      color: #fff;
      border-radius: 2px;
      padding: 0 2px;
    }
    .palette-item:hover mark, .palette-item.selected mark {
      background: #fff;
      color: #0284c7;
    }

    .palette-empty {
      padding: 2.5rem 1.5rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .palette-suggestions {
      display: flex;
      justify-content: center;
      gap: 0.4rem;
      margin-top: 0.75rem;
      flex-wrap: wrap;
    }

    .palette-footer {
      padding: 0.65rem 1.25rem;
      background: var(--bg-card-subtle);
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      color: var(--text-dim);
    }

    /* Web Awesome Dialog Tuning */
    .media-dialog::part(panel) {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      max-width: 900px;
      width: 95vw;
    }

    .media-dialog::part(body) {
      padding: 0;
      background: #000;
      height: 540px;
      max-height: 80vh;
    }

    .media-dialog iframe {
      width: 100%;
      height: 100%;
      border: none;
    }

    .image-dialog::part(panel) {
      background: transparent;
      border: none;
      box-shadow: none;
      max-width: 92vw;
      width: auto;
    }

    .image-dialog::part(body) {
      padding: 0;
      display: flex;
      justify-content: center;
    }

    .image-dialog img {
      max-width: 100%;
      max-height: 85vh;
      object-fit: contain;
      border-radius: var(--radius-md);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
      border: 1px solid var(--border-color);
    }

    /* Responsive Breakpoints */
    @media (max-width: 1024px) {
      .search-shortcut-badge {
        display: none;
      }
    }

    @media (max-width: 860px) {
      :root {
        --header-height: 56px;
      }
      header.top-header {
        padding: 0 0.75rem;
        gap: 0.5rem;
      }
      .brand-group {
        min-width: auto;
        gap: 0.5rem;
      }
      .brand-meta p {
        display: none;
      }
      .brand-meta h1 {
        font-size: 0.88rem;
      }
      .btn-print {
        display: none;
      }
      .filter-bar {
        padding: 0 0.75rem;
        gap: 0.75rem;
      }
    }

    @media (max-width: 640px) {
      header.top-header {
        padding: 0 0.5rem;
        gap: 0.35rem;
      }
      .brand-meta {
        display: none;
      }
      .search-label,
      .btn-label-doc,
      .btn-label-web,
      .btn-label-download {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      .view-switcher-group sl-button::part(base) {
        padding: 0 0.5rem;
      }
      .actions-group {
        gap: 0.25rem;
      }
      .actions-group sl-button::part(base) {
        padding: 0 0.5rem;
      }
      .search-trigger-btn::part(base) {
        padding: 0 0.5rem;
      }
      #viewInteractive {
        padding: 1.25rem 0.75rem 4rem;
      }
      .hero-card {
        margin-bottom: 1.5rem;
      }
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
        text-align: center;
      }
      .hero-title h2 {
        font-size: 1.35rem;
      }
      .hero-title p {
        font-size: 0.85rem;
      }
      .hero-stats {
        justify-content: center;
        gap: 0.75rem;
      }
      .stat-box {
        padding: 0.5rem 0.85rem;
      }
      .stat-number {
        font-size: 1.15rem;
      }
      .stat-label {
        font-size: 0.65rem;
      }
      .section-title {
        margin: 2rem 0 1rem;
        font-size: 1.15rem;
      }
      .timeline-container {
        padding-left: 1.25rem;
      }
      .timeline-container::before {
        left: 5px;
      }
      .exp-node {
        left: -1.25rem;
        width: 12px;
        height: 12px;
        top: 1.4rem;
      }
      .exp-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
      }
      .exp-role {
        font-size: 1rem;
      }
      .pipeline-box {
        padding: 0.5rem 0.75rem;
        gap: 0.35rem;
      }
      .pipeline-step {
        font-size: 0.72rem;
        padding: 0.2rem 0.45rem;
      }
      .projects-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
      }
      .skills-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
      }
      #viewDocument {
        padding: 1rem 0.5rem 3.5rem;
      }
      .doc-controls {
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem;
        max-width: 100%;
      }
      .doc-controls sl-button::part(base) {
        padding: 0 0.45rem;
        font-size: 0.74rem;
      }
    }
  </style>
</head>
<body>
  <!-- Header with Web Awesome Components -->
  <header class="top-header">
    <div class="brand-group">
      <sl-avatar label="{{ profile.name }}" initials="LA" style="--size: 34px; --border-radius: 8px;"></sl-avatar>
      <div class="brand-meta">
        <h1>{{ profile.name }}</h1>
        <p>{{ profile.title }}</p>
      </div>
    </div>

    <!-- Center View Switcher (Web Awesome Button Group) -->
    <div class="view-switcher-group">
      <sl-button-group label="Sélecteur de Vue">
        <sl-tooltip content="Affichage PDF Haute Fidélité ISO (Touche V)">
          <sl-button variant="default" size="small" id="tabDoc" aria-label="Afficher le document PDF ISO" onclick="switchMainView('doc')">
            <sl-icon slot="prefix" name="file-earmark-pdf"></sl-icon>
            <span class="btn-label-doc">Document ISO</span>
          </sl-button>
        </sl-tooltip>
        <sl-tooltip content="Affichage Portfolio Web Interactif (Touche V)">
          <sl-button variant="primary" size="small" id="tabWeb" aria-label="Afficher la vue web interactive" onclick="switchMainView('web')">
            <sl-icon slot="prefix" name="grid-3x3-gap"></sl-icon>
            <span class="btn-label-web">Vue Interactive</span>
          </sl-button>
        </sl-tooltip>
      </sl-button-group>
    </div>

    <!-- Smart Search Trigger (Web Awesome Button) -->
    <sl-tooltip content="Recherche Floue & Sémantique (Ctrl + K)">
      <sl-button variant="default" size="small" aria-label="Rechercher des compétences, projets et technologies" onclick="openPalette()" class="search-trigger-btn">
        <sl-icon slot="prefix" name="search"></sl-icon>
        <span class="search-label">Smart Search...</span>
        <sl-badge slot="suffix" variant="neutral" pill class="search-shortcut-badge">Ctrl K</sl-badge>
      </sl-button>
    </sl-tooltip>

    <!-- Actions (Web Awesome Buttons & Tooltips) -->
    <div class="actions-group">
      <sl-tooltip content="Basculer Thème Sombre / Clair (T)">
        <sl-icon-button id="themeToggleBtn" name="moon" label="Changer de thème" aria-label="Changer de thème sombre/clair" onclick="toggleTheme()"></sl-icon-button>
      </sl-tooltip>

      <sl-tooltip content="Imprimer au format A4 (P)">
        <sl-button variant="default" size="small" aria-label="Imprimer le CV au format A4" onclick="window.print()" class="btn-print">
          <sl-icon slot="prefix" name="printer"></sl-icon>
          <span class="btn-label-print">Imprimer</span>
        </sl-button>
      </sl-tooltip>

      <sl-tooltip content="Télécharger le PDF Typst (D)">
        <sl-button variant="primary" size="small" aria-label="Télécharger le CV PDF" href="{{ pdf_filename }}" download class="btn-download">
          <sl-icon slot="prefix" name="download"></sl-icon>
          <span class="btn-label-download">Télécharger PDF</span>
        </sl-button>
      </sl-tooltip>
    </div>
  </header>

  <!-- Filter & Contact Bar -->
  <div class="filter-bar">
    <div class="domain-filters">
      <button type="button" class="filter-tag active" data-domain="all" onclick="filterByDomain('all')">Tous</button>
      <button type="button" class="filter-tag" data-domain="backend" onclick="filterByDomain('backend')">🐍 Python & Backend</button>
      <button type="button" class="filter-tag" data-domain="graphics" onclick="filterByDomain('graphics')">🎮 C++ & 3D Temps-Réel</button>
      <button type="button" class="filter-tag" data-domain="cloud" onclick="filterByDomain('cloud')">☁️ Cloud & DevOps</button>
      <button type="button" class="filter-tag" data-domain="ai" onclick="filterByDomain('ai')">🤖 IA & Agents</button>
      <button type="button" class="filter-tag" data-domain="sig" onclick="filterByDomain('sig')">🗺️ SIG & Géomatique</button>
      <sl-button variant="primary" size="small" pill style="--sl-color-primary-600:#0284c7;" onclick="goToMediaSection()">
        <sl-icon slot="prefix" name="play-circle"></sl-icon>
        🎬 Démos, Médias & Talks
      </sl-button>
    </div>

    <div class="contact-chips">
      <sl-tooltip content="Envoyer un email">
        <a href="mailto:{{ profile.email }}" class="contact-chip">
          <sl-icon name="envelope"></sl-icon>
          <span>{{ profile.email }}</span>
        </a>
      </sl-tooltip>
      <sl-tooltip content="Appeler">
        <a href="tel:{{ profile.phone | replace(' ', '') }}" class="contact-chip">
          <sl-icon name="telephone"></sl-icon>
          <span>{{ profile.phone }}</span>
        </a>
      </sl-tooltip>
      <sl-tooltip content="Profil GitHub">
        <a href="https://github.com/yoyonel" target="_blank" rel="noopener noreferrer" class="contact-chip">
          <sl-icon name="github"></sl-icon>
          <span>GitHub</span>
        </a>
      </sl-tooltip>
      <sl-tooltip content="Profil LinkedIn">
        <a href="{{ profile.linkedin | default('https://www.linkedin.com/in/lionel-atty-6a55b748/') }}" target="_blank" rel="noopener noreferrer" class="contact-chip">
          <sl-icon name="linkedin"></sl-icon>
          <span>LinkedIn</span>
        </a>
      </sl-tooltip>
    </div>
  </div>

  <!-- ========================================================
       VIEW 1: DOCUMENT ISO PDF
       ======================================================== -->
  <main id="viewDocument">
    <div class="doc-controls">
      <sl-button-group label="Contrôles PDF">
        <sl-button variant="primary" size="small" id="btnModeSingle" onclick="toggleDocSingle()">
          <span id="lblPageNum">Page 1/2</span>
        </sl-button>
        <sl-button variant="default" size="small" id="btnModeDual" onclick="setDocMode('dual')">Double Page</sl-button>
        <sl-button variant="default" size="small" id="btnModeContinuous" onclick="setDocMode('continuous')">Continu</sl-button>
      </sl-button-group>

      <sl-button-group label="Zoom PDF">
        <sl-button variant="default" size="small" onclick="zoomDoc(-0.1)">-</sl-button>
        <sl-button variant="default" size="small" disabled>
          <span id="lblZoom" style="font-family:'JetBrains Mono',monospace;">100%</span>
        </sl-button>
        <sl-button variant="default" size="small" onclick="zoomDoc(0.1)">+</sl-button>
      </sl-button-group>
    </div>

    <div class="pages-wrapper mode-single" id="pagesWrapper">
      <div class="pdf-page-container active" id="pageContainer1">
        <div class="page-tag">PAGE 01 / 02</div>
        <canvas id="canvasPage1" width="840" height="1188"></canvas>
        <div class="textLayer" id="textLayer1"></div>
      </div>
      <div class="pdf-page-container" id="pageContainer2">
        <div class="page-tag">PAGE 02 / 02</div>
        <canvas id="canvasPage2" width="840" height="1188"></canvas>
        <div class="textLayer" id="textLayer2"></div>
      </div>
    </div>

    <!-- Callout Banner to discover Interactive Web View -->
    <div class="hero-card" style="margin-top:2.5rem; max-width:840px; cursor:pointer;" onclick="switchMainView('web')">
      <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem;">
        <div style="display:flex; align-items:center; gap:0.85rem;">
          <sl-icon name="stars" style="font-size:1.6rem; color:var(--accent);"></sl-icon>
          <div>
            <strong style="color:var(--text-main);">Mode Portfolio Web & Démos interactives disponible</strong>
            <p style="font-size:0.82rem; color:var(--text-muted); margin-top:0.2rem;">
              Timeline animée, démos vidéos YouTube, slides FOSS4G, grille de compétences et filtres dynamiques.
            </p>
          </div>
        </div>
        <sl-button variant="primary" size="small" pill>
          Ouvrir la Vue Interactive (V)
          <sl-icon slot="suffix" name="arrow-right"></sl-icon>
        </sl-button>
      </div>
    </div>
  </main>

  <!-- ========================================================
       VIEW 2: INTERACTIVE PORTFOLIO & WEB APP
       ======================================================== -->
  <main id="viewInteractive">
    <!-- Hero Summary Card -->
    <div class="hero-card">
      <div class="hero-grid">
        <div class="hero-title">
          <h2>{{ profile.name }}</h2>
          <p>{{ profile.title }} — {{ profile.specialties }}</p>
          <p style="margin-top:0.4rem; font-size:0.85rem; color:var(--text-dim);">
            📍 {{ profile.address }} &bull; {{ profile.mobility }} &bull; {{ profile.age }} ans
          </p>
        </div>
        <div class="hero-stats">
          <div class="stat-box">
            <div class="stat-number">20+</div>
            <div class="stat-label">Ans d'expérience</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">40+</div>
            <div class="stat-label">Technologies</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Experiences Timeline (Web Awesome Cards) -->
    <h3 class="section-title">Expériences Professionnelles</h3>
    <div class="timeline-container">
      {% for exp in resume_data.experiences %}
      <div class="exp-wrapper" data-id="{{ exp.id }}" data-domains="{{ exp.domains | join(',') }}" style="position:relative;">
        <div class="exp-node"></div>
        <article class="wa-exp-card" id="exp-{{ exp.id }}">
          <div class="exp-header">
            <div>
              <div class="exp-role">{{ exp.role }}</div>
              <div class="exp-company">{{ exp.company }} <span style="font-size:0.8rem; color:var(--text-dim); font-weight:normal;">({{ exp.location }})</span></div>
            </div>
            <sl-badge variant="neutral" pill style="font-family:'JetBrains Mono',monospace;">{{ exp.dates }}</sl-badge>
          </div>

          <div class="exp-summary">{{ exp.summary }}</div>

          <ul class="exp-bullets">
            {% for b in exp.bullets %}
            <li>{{ b }}</li>
            {% endfor %}
          </ul>

          {% if exp.pipeline %}
          <div class="pipeline-box">
            <span class="pipeline-label">Flux Architecture :</span>
            {% for step in exp.pipeline %}
            <span class="pipeline-step">{{ step }}</span>
            {% if not loop.last %}<span class="pipeline-arrow">▶</span>{% endif %}
            {% endfor %}
          </div>
          {% endif %}

          <div class="tags-container">
            {% for t in exp.tags %}
            <span class="tech-tag-item" onclick="filterByTech('{{ t }}')">{{ t }}</span>
            {% endfor %}
          </div>

          {% if exp.links %}
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:1rem;">
            {% for l in exp.links %}
            <sl-button variant="default" size="small" href="{{ l.url }}" target="_blank" rel="noopener noreferrer">
              <sl-icon slot="prefix" name="{{ 'file-earmark-slides' if l.icon == 'slides' else ('github' if l.icon == 'github' else 'link-45deg') }}"></sl-icon>
              {{ l.label }}
            </sl-button>
            {% endfor %}
          </div>
          {% endif %}
        </article>
      </div>
      {% endfor %}
    </div>

    <!-- Media, Projects & Talks (Web Awesome Cards & Carousels) -->
    <h3 class="section-title" id="section-projects">Projets R&D, Talks & Conférences</h3>
    <div class="projects-grid">
      {% for proj in resume_data.projects_and_talks %}
      {% set proj_idx = loop.index %}
      <div class="project-wrapper" data-domain="{{ proj.domain }}" style="height:100%;">
        <article class="wa-project-card" id="proj-{{ proj_idx }}">
          <div>
            <div class="project-category">{{ proj.category }} &bull; {{ proj.dates }}</div>
            <div class="project-title">{{ proj.title }}</div>
            <p class="project-desc">{{ proj.description }}</p>

            {% if proj.media %}
            <div class="project-media-box">
              {% if proj.media.type == 'video' %}
              <div class="project-media-main" onclick="openMediaModal('{{ proj.media.video_url }}', '{{ proj.title }}')">
                <span class="media-badge-overlay">▶ VIDÉO MASTERCLASS</span>
                <img src="{{ proj.media.src }}" alt="{{ proj.title }}" loading="lazy" decoding="async" width="800" height="450">
                <div class="video-play-btn">▶</div>
                <div class="media-zoom-overlay"><span>Lancer la vidéo</span></div>
              </div>
              {% else %}
              <div class="project-media-main" id="media-main-{{ proj_idx }}" onclick="openImageModal(document.getElementById('media-img-{{ proj_idx }}').src, '{{ proj.title }}')">
                <span class="media-badge-overlay" id="media-badge-{{ proj_idx }}">{{ '🔥 DÉMO ANIMÉE' if proj.media.type == 'gif' else '📸 CAPTURE R&D' }}</span>
                <img id="media-img-{{ proj_idx }}" src="{{ proj.media.src }}" alt="{{ proj.title }}" loading="lazy" decoding="async" width="800" height="450">
                <div class="media-zoom-overlay"><sl-icon name="zoom-in"></sl-icon><span>Agrandir</span></div>
              </div>
              {% if proj.media.gallery %}
              <div class="media-gallery-thumbs">
                {% for g in proj.media.gallery %}
