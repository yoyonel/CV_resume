            meta: tagUrl ? "Lien externe" : "Tag",
            keywords: tagName + " " + cat.title + (tagUrl ? " doc vtune profiler perf linux intel" : ""),
            action: () => tagUrl ? window.open(tagUrl, '_blank') : filterByTech(tagName)
