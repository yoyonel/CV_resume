          {% if proj.links %}
          <div class="project-links">
            {% for l in proj.links %}
            {% if l.icon == 'slides' %}
            <button class="btn-link" onclick="openMediaModal('{{ l.url }}', '{{ l.label }}')">📊 {{ l.label }}</button>
            {% elif l.icon == 'video' %}
            <button class="btn-link" onclick="openMediaModal('https://www.youtube.com/embed/aaim2oCGedk', '{{ l.label }}')">▶️ {{ l.label }}</button>
            {% else %}
            <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer" class="btn-link">🔗 {{ l.label }}</a>
            {% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>

    <!-- Skills Categorized -->
    <h3 class="section-title">Grille de Compétences & Technologies</h3>
    <div class="skills-grid">
      {% for cat in resume_data.skills_categories %}
      <div class="skill-block" id="skill-{{ loop.index }}" data-domain="{{ cat.domain }}">
