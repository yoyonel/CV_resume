  <!-- Header with Native Modern Components -->
  <header class="top-header">
    <div class="brand-group">
      <div class="brand-avatar" aria-label="{{ profile.name }}">LA</div>
      <div class="brand-meta">
        <h1>{{ profile.name }}</h1>
        <p>{{ profile.title }}</p>
      </div>
    </div>

    <!-- Center View Switcher (Native Button Group) -->
    <div class="view-switcher-group">
      <div class="btn-group" role="group" aria-label="Sélecteur de Vue">
        <button type="button" class="btn btn-sm btn-primary active" id="tabDoc" aria-label="Afficher le document PDF ISO" data-tooltip="Affichage PDF Haute Fidélité ISO (Touche V)" onclick="switchMainView('doc')">
          <svg class="icon"><use href="#icon-file-earmark-pdf"></use></svg>
          <span class="btn-label-doc">Document ISO</span>
        </button>
        <button type="button" class="btn btn-sm btn-default" id="tabWeb" aria-label="Afficher la vue web interactive" data-tooltip="Affichage Portfolio Web Interactif (Touche V)" onclick="switchMainView('web')">
          <svg class="icon"><use href="#icon-grid-3x3-gap"></use></svg>
          <span class="btn-label-web">Vue Interactive</span>
        </button>
      </div>
    </div>

    <!-- Smart Search Trigger (Native Button) -->
    <button type="button" class="btn btn-default btn-sm search-trigger-btn" aria-label="Rechercher des compétences, projets et technologies" data-tooltip="Recherche Floue & Sémantique (Ctrl + K)" onclick="openPalette()">
      <svg class="icon"><use href="#icon-search"></use></svg>
      <span class="search-label">Smart Search...</span>
      <kbd class="search-shortcut-kbd">Ctrl K</kbd>
    </button>

    <!-- Actions (Native Buttons & Tooltips) -->
    <div class="actions-group">
      <button type="button" class="btn btn-icon btn-ghost" id="themeToggleBtn" aria-label="Changer de thème sombre/clair" data-tooltip="Basculer Thème (T)" onclick="toggleTheme()">
        <svg class="icon" style="font-size:1.1rem;"><use id="themeIconUse" href="#icon-moon"></use></svg>
      </button>

      <button type="button" class="btn btn-default btn-sm btn-print" aria-label="Imprimer le CV au format PDF" data-tooltip="Imprimer le CV PDF (P)" onclick="printResume()">
        <svg class="icon"><use href="#icon-printer"></use></svg>
        <span class="btn-label-print">Imprimer</span>
      </button>

      <a class="btn btn-primary btn-sm btn-download" aria-label="Télécharger le CV PDF" data-tooltip="Télécharger le PDF Typst (D)" href="{{ pdf_filename }}" download>
        <svg class="icon"><use href="#icon-download"></use></svg>
        <span class="btn-label-download">Télécharger PDF</span>
      </a>
    </div>
  </header>

  <!-- Filter & Contact Bar -->
  <div class="filter-bar">
    <div class="domain-filters">
      <button type="button" class="filter-tag active" data-domain="all" onclick="filterByDomain('all', event)" title="Afficher tous les domaines">Tous</button>
      <button type="button" class="filter-tag" data-domain="backend" onclick="filterByDomain('backend', event)" title="Filtrer Python & Backend (Shift+Clic pour cumuler)">🐍 Python & Backend</button>
      <button type="button" class="filter-tag" data-domain="graphics" onclick="filterByDomain('graphics', event)" title="Filtrer C++ & 3D Temps-Réel (Shift+Clic pour cumuler)">🎮 C++ & 3D Temps-Réel</button>
      <button type="button" class="filter-tag" data-domain="cloud" onclick="filterByDomain('cloud', event)" title="Filtrer Cloud & DevOps (Shift+Clic pour cumuler)">☁️ Cloud & DevOps</button>
      <button type="button" class="filter-tag" data-domain="ai" onclick="filterByDomain('ai', event)" title="Filtrer IA & Agents (Shift+Clic pour cumuler)">🤖 IA & Agents</button>
      <button type="button" class="filter-tag" data-domain="sig" onclick="filterByDomain('sig', event)" title="Filtrer SIG & Géomatique (Shift+Clic pour cumuler)">🗺️ SIG & Géomatique</button>
      <button type="button" class="btn btn-primary btn-sm btn-pill" style="background:#0284c7; border-color:#0284c7;" onclick="goToMediaSection()">
        <svg class="icon"><use href="#icon-play-circle"></use></svg>
        <span>🎬 Démos, Médias & Talks</span>
      </button>
    </div>

    <div class="contact-chips">
      <a href="mailto:{{ profile.email }}" class="contact-chip" title="Envoyer un email ({{ profile.email }})">
        <svg class="icon" ><use href="#icon-envelope"></use></svg>
        <span>{{ profile.email }}</span>
      </a>
      <a href="tel:{{ profile.phone | replace(' ', '') }}" class="contact-chip" title="Appeler ({{ profile.phone }})">
        <svg class="icon" ><use href="#icon-telephone"></use></svg>
        <span>{{ profile.phone }}</span>
      </a>
      <a href="https://github.com/yoyonel" target="_blank" rel="noopener noreferrer" class="contact-chip" title="Profil GitHub">
        <svg class="icon" ><use href="#icon-github"></use></svg>
        <span>GitHub</span>
      </a>
      <a href="{{ profile.linkedin | default('https://www.linkedin.com/in/lionel-atty-6a55b748/') }}" target="_blank" rel="noopener noreferrer" class="contact-chip" title="Profil LinkedIn">
        <svg class="icon" ><use href="#icon-linkedin"></use></svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>

  <!-- ========================================================
       VIEW 1: INTERACTIVE PORTFOLIO & WEB APP
       ======================================================== -->
  <main id="viewInteractive">
    <!-- Hero Summary Card -->
    <div class="hero-card">
      <div class="hero-grid">
        <div class="hero-title">
          <h2>{{ profile.name }}</h2>
          <p>{{ profile.title }} — {{ profile.specialties }}</p>
          <p style="margin-top:0.4rem; font-size:0.85rem; color:var(--text-dim);">
            📍 {{ profile.address }} &bull; {{ profile.mobility }} &bull; {{ profile.age }} ans
          </p>
        </div>
        <div class="hero-stats">
          <div class="stat-box">
            <div class="stat-number">20+</div>
            <div class="stat-label">Ans d'expérience</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">40+</div>
            <div class="stat-label">Technologies</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Experiences Timeline (Web Awesome Cards) -->
    <h3 class="section-title">Expériences Professionnelles</h3>
    <div class="timeline-container">
      {% for exp in resume_data.experiences %}
      <div class="exp-wrapper" data-id="{{ exp.id }}" data-domains="{{ exp.domains | join(',') }}" style="position:relative;">
        <div class="exp-node"></div>
        <article class="wa-exp-card" id="exp-{{ exp.id }}">
          <div class="exp-header">
            <div>
              <div class="exp-role">{{ exp.role }}</div>
              <div class="exp-company">{{ exp.company }} <span style="font-size:0.8rem; color:var(--text-dim); font-weight:normal;">({{ exp.location }})</span></div>
            </div>
            <span class="badge-pill">{{ exp.dates }}</span>
          </div>

          <div class="exp-summary">{{ exp.summary }}</div>

          <ul class="exp-bullets">
            {% for b in exp.bullets %}
            <li>{{ b | highlight_kw | safe }}</li>
            {% endfor %}
          </ul>

          {% if exp.pipeline %}
          <div class="pipeline-box">
            <span class="pipeline-label">Flux Architecture :</span>
            {% for step in exp.pipeline %}
            <span class="pipeline-step">{{ step }}</span>
            {% if not loop.last %}<span class="pipeline-arrow">▶</span>{% endif %}
            {% endfor %}
          </div>
          {% endif %}

          <div class="tags-container">
            {% for t in exp.tags %}
            <span class="tech-tag-item family-{{ t | tech_family }}" onclick="filterByTech('{{ t }}', event)">{{ t }}</span>
            {% endfor %}
          </div>

          {% if exp.links %}
          <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:1rem;">
            {% for l in exp.links %}
            <a class="btn btn-sm btn-ghost" href="{{ l.url }}" target="_blank" rel="noopener noreferrer">
              <svg class="icon"><use href="#icon-{{ 'file-earmark-slides' if l.icon == 'slides' else ('github' if l.icon == 'github' else 'link-45deg') }}"></use></svg>
              <span>{{ l.label }}</span>
            </a>
            {% endfor %}
          </div>
          {% endif %}
        </article>
      </div>
      {% endfor %}
    </div>

    <!-- Media, Projects & Talks (Web Awesome Cards & Carousels) -->
    <h3 class="section-title" id="section-projects">Projets R&D, Talks & Conférences</h3>
    <div class="projects-grid">
      {% for proj in resume_data.projects_and_talks %}
      {% set proj_idx = loop.index %}
      <div class="project-wrapper" data-domain="{{ proj.domain }}" data-domains="{{ proj.domains | join(',') if proj.domains else proj.domain }}" style="height:100%;">
        <article class="wa-project-card" id="proj-{{ proj_idx }}">
          <div>
            <div class="project-category">{{ proj.category }} &bull; {{ proj.dates }}</div>
            <div class="project-title">{{ proj.title }}</div>
            <p class="project-desc">{{ proj.description | highlight_kw | safe }}</p>

            {% if proj.media %}
            <div class="project-media-box">
              {% if proj.media.type == 'video' %}
              <div class="project-media-main" data-video-url="{{ proj.media.video_url }}" data-title="{{ proj.title | e }}" onclick="openMediaModalByElem(this)">
                <span class="media-badge-overlay">▶ VIDÉO MASTERCLASS</span>
                <img src="{{ proj.media.src }}" alt="{{ proj.title }}" loading="lazy" decoding="async" width="800" height="450">
                <div class="video-play-btn">▶</div>
                <div class="media-zoom-overlay"><span>Lancer la vidéo</span></div>
              </div>
              {% else %}
              <div class="project-media-main" id="media-main-{{ proj_idx }}" data-card-idx="{{ proj_idx }}" data-title="{{ proj.title | e }}" onclick="openImageModalByElem(this)">
                <span class="media-badge-overlay" id="media-badge-{{ proj_idx }}">{{ '🔥 DÉMO ANIMÉE' if proj.media.type == 'gif' else '📸 CAPTURE R&D' }}</span>
                <img id="media-img-{{ proj_idx }}" src="{{ proj.media.src }}{{ '?v=' ~ build_id if not proj.media.src.startswith('http') else '' }}" alt="{{ proj.title }}" loading="lazy" decoding="async" width="800" height="450">
                <div class="media-zoom-overlay"><svg class="icon" ><use href="#icon-zoom-in"></use></svg><span>Agrandir</span></div>
              </div>
              {% if proj.media.gallery %}
              <div class="media-gallery-thumbs">
                {% for g in proj.media.gallery %}
                <button type="button" class="btn btn-sm {{ 'btn-primary' if loop.first else 'btn-default' }} media-thumb-btn-{{ proj_idx }}" data-card-idx="{{ proj_idx }}" data-src="{{ g.src }}{{ '?v=' ~ build_id if not g.src.startswith('http') else '' }}" data-label="{{ g.label }}" onclick="switchCardMediaByElem(this)">
                  {{ g.label }}
                </button>
                {% endfor %}
              </div>
              {% endif %}
              {% endif %}
            </div>
            {% endif %}
          </div>

          <div style="margin-top:auto;">
            <div class="tags-container" style="margin-bottom:0.85rem;">
              {% for t in proj.tags %}
              <span class="tech-tag-item family-{{ t | tech_family }}" onclick="filterByTech('{{ t }}', event)">{{ t }}</span>
              {% endfor %}
            </div>

            {% if proj.links %}
            <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
              {% for l in proj.links %}
              {% if l.icon == 'slides' %}
              <button type="button" class="btn btn-sm btn-default" onclick="openMediaModal('{{ l.url }}', '{{ l.label }}')">
                <svg class="icon"><use href="#icon-file-earmark-slides"></use></svg>
                <span>{{ l.label }}</span>
              </button>
              {% elif l.icon == 'video' %}
              <button type="button" class="btn btn-sm btn-primary" onclick="openMediaModal('https://www.youtube.com/embed/aaim2oCGedk', '{{ l.label }}')">
                <svg class="icon"><use href="#icon-play-circle"></use></svg>
                <span>{{ l.label }}</span>
              </button>
              {% else %}
              <a class="btn btn-sm btn-ghost" href="{{ l.url }}" target="_blank" rel="noopener noreferrer">
                <svg class="icon"><use href="#icon-{{ 'github' if l.icon == 'github' else 'link-45deg' }}"></use></svg>
                <span>{{ l.label }}</span>
              </a>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </article>
      </div>
      {% endfor %}
    </div>

    <!-- Skills Categorized (Web Awesome Cards) -->
    <h3 class="section-title">Grille de Compétences & Technologies</h3>
    <div class="skills-grid">
      {% for cat in resume_data.skills_categories %}
      <div class="skill-wrapper" data-domain="{{ cat.domain }}">
        <div class="wa-skill-card" id="skill-{{ loop.index }}">
          <div class="skill-card-title">
            <svg class="icon"  style="color:var(--accent);"><use href="#icon-tools"></use></svg>
            <span>{{ cat.title }}</span>
          </div>
          <div class="tags-container">
            {% for t in cat.tags %}
            {% if t is mapping %}
            <a href="{{ t.url }}" target="_blank" rel="noopener noreferrer" style="text-decoration:none;" title="Documentation officielle : {{ t.name }}">
              <span class="tech-tag-item family-{{ t.name | tech_family }}">
                {{ t.name }} <svg class="icon"  style="font-size:0.65em; margin-left:3px;"><use href="#icon-box-arrow-up-right"></use></svg>
              </span>
            </a>
            {% else %}
            <span class="tech-tag-item family-{{ t | tech_family }}" onclick="filterByTech('{{ t }}', event)">{{ t }}</span>
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

    <!-- Formation & Diplômes (Web Awesome Cards) -->
    <h3 class="section-title">Formation & Diplômes</h3>
    <div class="timeline-container">
      {% for edu in resume_data.education %}
      <div class="exp-wrapper" data-domain="{{ edu.domain }}" style="position:relative;">
        <div class="exp-node"></div>
        <div class="wa-exp-card">
          <div class="exp-header">
            <div>
              <div class="exp-role">{{ edu.degree }}</div>
              <div class="exp-company">{{ edu.institution }}</div>
            </div>
            <span class="badge-pill">{{ edu.dates }}</span>
          </div>
          <div class="exp-summary">{{ edu.description }}</div>
          {% if edu.publication %}
          <div style="font-size:0.82rem; background:var(--bg-card-subtle); padding:0.75rem; border-radius:6px; border:1px solid var(--border-color); display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <div>
              📖 <strong>Publication CGF</strong> : <em>{{ edu.publication.title }}</em> ({{ edu.publication.journal }})
            </div>
            <a class="btn btn-sm btn-default" href="{{ edu.publication.url }}" target="_blank" rel="noopener noreferrer">
              <svg class="icon"><use href="#icon-box-arrow-up-right"></use></svg>
              <span>Consulter</span>
            </a>
          </div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </main>

  <!-- ========================================================
       VIEW 2: DOCUMENT ISO PDF
       ======================================================== -->
  <main id="viewDocument">
    <div class="doc-controls">
      <!-- Mode Selection -->
      <div class="btn-group" role="group" aria-label="Mode d'affichage PDF">
        <button type="button" class="btn btn-sm" id="btnModeSingle" onclick="setDocMode('single')">Page Simple</button>
        <button type="button" class="btn btn-sm active" id="btnModeDual" onclick="setDocMode('dual')">Double Page</button>
        <button type="button" class="btn btn-sm" id="btnModeContinuous" onclick="setDocMode('continuous')">Continu</button>
      </div>

      <!-- Pagination Group (Single Page Mode) -->
      <div class="btn-group" id="singlePageNav" role="group" aria-label="Pagination PDF" style="display:none;">
        <button type="button" class="btn btn-sm" id="btnPrevPage" onclick="prevDocPage()" aria-label="Page précédente" data-tooltip="Page précédente (Flèche Gauche / Page Up)">
          <svg class="icon"><use href="#icon-chevron-left"></use></svg>
        </button>
        <span class="btn-group-label" id="lblPageNum">Page 1 / 2</span>
        <button type="button" class="btn btn-sm" id="btnNextPage" onclick="nextDocPage()" aria-label="Page suivante" data-tooltip="Page suivante (Flèche Droite / Page Down)">
          <svg class="icon"><use href="#icon-chevron-right"></use></svg>
        </button>
      </div>

      <!-- Zoom Controls -->
      <div class="btn-group" role="group" aria-label="Zoom PDF">
        <button type="button" class="btn btn-sm" onclick="zoomDoc(-0.1)" data-tooltip="Zoom arrière (-)">-</button>
        <span class="btn-group-label" id="lblZoom">100%</span>
        <button type="button" class="btn btn-sm" onclick="zoomDoc(0.1)" data-tooltip="Zoom avant (+)">+</button>
      </div>
    </div>

    <div class="pages-wrapper mode-dual" id="pagesWrapper">
      <div class="pdf-page-container active" id="pageContainer1">
        <div class="page-tag">PAGE 01 / 02</div>
        <img class="print-vector-page" src="assets/cv-page-1.svg" alt="Curriculum Vitae Lionel ATTY Page 1" loading="lazy" decoding="async" />
        <canvas id="canvasPage1" width="840" height="1188"></canvas>
        <div class="textLayer" id="textLayer1"></div>
      </div>
      <div class="pdf-page-container active" id="pageContainer2">
        <div class="page-tag">PAGE 02 / 02</div>
        <img class="print-vector-page" src="assets/cv-page-2.svg" alt="Curriculum Vitae Lionel ATTY Page 2" loading="lazy" decoding="async" />
        <canvas id="canvasPage2" width="840" height="1188"></canvas>
        <div class="textLayer" id="textLayer2"></div>
      </div>
    </div>

    <!-- Callout Banner to discover Interactive Web View -->
