  <script>
    const RESUME_DATA = {{ resume_json | safe }};
    const PDF_URL = "{{ pdf_filename }}";
    let pdfDoc = null;
    let currentMainView = 'doc';
    let docZoom = 1.0;
    let docMode = 'single';
    let docPageNum = 1;
    let activeDomainFilter = 'all';

    let searchIndex = [];
    let selectedPaletteIndex = 0;
    let currentPaletteResults = [];

    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    // 1. Build Deep Semantic & Fuzzy Search Index
    function buildSearchIndex() {
      const idx = [];

      // Synonyms dictionary for smart semantic match
      const SYNONYMS = {
        "suckless": ["suckless-vulkan", "suckless-ogl", "suckless-odin", "suckless-rust", "vulkan", "opengl", "c++", "cpp", "odin", "rust", "rendu", "3d", "gpu", "simd", "bas-niveau", "rust-firework"],
        "suckless-vulkan": ["suckless", "vulkan", "opengl", "c++", "cpp", "odin", "rust", "rendu", "3d", "gpu"],
        "suckless-ogl": ["suckless", "opengl", "ogl", "glsl", "shaders", "c++", "cpp", "rendu", "3d", "gpu"],
        "suckless-odin": ["suckless", "odin", "simd", "data-oriented", "rendu", "3d", "gpu", "bas-niveau"],
        "suckless-rust": ["suckless", "rust", "rust-firework", "ecs", "simd", "rendu", "3d", "gpu"],
        "rust-firework": ["firework", "particules", "simulation", "rust", "gpu", "shaders", "volumetric", "lights", "temps-reel", "suckless-rust"],
        "firework": ["rust-firework", "particules", "simulation", "rust", "gpu", "shaders", "volumetric"],
        "particules": ["rust-firework", "firework", "simulation", "gpu", "shaders", "rust"],
        "volumetric": ["volumetric dynamic lights", "rust-firework", "shaders", "gpu", "rendu 3d"],
        "compiz": ["compiz-reloaded", "opengl", "3d", "window manager", "c++", "linux"],
        "llm": ["ia", "ai", "genai", "claude", "mcp", "dust", "n8n", "openai", "gemini", "nlp", "spacy", "gensim", "transformers"],
        "ia": ["llm", "ai", "genai", "claude", "mcp", "dust", "n8n", "nlp", "intelligence artificielle"],
        "ai": ["llm", "ia", "genai", "claude", "mcp", "dust", "n8n", "nlp"],
        "mcp": ["serveurs mcp", "mcp servers", "claude code", "llm", "ia", "context", "tooling"],
        "vulkan": ["suckless", "suckless-vulkan", "3d", "gpu", "rendu", "shaders", "c++", "cpp", "spir-v", "graphics", "opengl"],
        "opengl": ["suckless", "suckless-ogl", "3d", "gpu", "rendu", "shaders", "c++", "cpp", "vulkan", "glsl"],
        "c++": ["cpp", "c11", "c17", "c20", "3d", "gpu", "vulkan", "opengl", "ros", "simd", "performance", "suckless"],
        "cpp": ["c++", "c11", "c17", "c20", "3d", "gpu", "vulkan", "opengl", "ros", "simd", "suckless"],
        "rust": ["rust-firework", "suckless-rust", "simd", "ecs", "particules", "bas-niveau", "performance"],
        "odin": ["suckless-odin", "simd", "data-oriented", "bas-niveau", "performance"],
        "python": ["fastapi", "flask", "asyncio", "celery", "pydantic", "django", "pytest", "backend"],
        "backend": ["python", "fastapi", "flask", "microservices", "api", "rest", "grpc", "postgresql", "redis"],
        "cloud": ["azure", "aks", "docker", "kubernetes", "k8s", "gcp", "terraform", "ansible", "devops", "ci/cd"],
        "k8s": ["kubernetes", "aks", "docker", "cloud", "devops"],
        "devops": ["ci/cd", "gitlab ci", "github actions", "docker", "kubernetes", "ansible", "terraform"],
        "sig": ["gis", "postgis", "qgis", "geopandas", "geoalchemy2", "spatial", "carto", "lidar", "ign", "li3ds"],
        "gis": ["sig", "postgis", "qgis", "geopandas", "lidar", "spatial", "li3ds"],
        "these": ["doctorat", "phd", "recherche", "inria", "cgf", "publication", "ombres douces", "shadow maps"],
        "phd": ["doctorat", "these", "recherche", "inria", "cgf", "publication"],
      };

      // A. Actions
      const actions = [
        { title: "Basculer vers Vue Interactive (Portfolio Web)", icon: "⚡", cat: "Actions", meta: "Vue", action: () => switchMainView('web'), keywords: "web portfolio timeline vue interactive changer basculer" },
        { title: "Basculer vers Vue Document (ISO PDF Typst)", icon: "📄", cat: "Actions", meta: "Vue", action: () => switchMainView('doc'), keywords: "document pdf typst iso rendu papier exact" },
        { title: "Filtrer : Python & Backend Microservices", icon: "🐍", cat: "Actions", meta: "Filtre", action: () => filterByDomain('backend'), keywords: "python backend fastapi flask celery async microservices" },
        { title: "Filtrer : C++ & Rendu 3D Temps-Réel (Vulkan/GPU)", icon: "🎮", cat: "Actions", meta: "Filtre", action: () => filterByDomain('graphics'), keywords: "c++ cpp 3d gpu vulkan opengl shaders rendu moteur graphics" },
        { title: "Filtrer : Cloud, DevOps & Conteneurs", icon: "☁️", cat: "Actions", meta: "Filtre", action: () => filterByDomain('cloud'), keywords: "cloud devops azure aks docker kubernetes k8s terraform ansible" },
        { title: "Filtrer : IA Agentique, LLM & Serveurs MCP", icon: "🤖", cat: "Actions", meta: "Filtre", action: () => filterByDomain('ai'), keywords: "ia ai llm mcp claude code dust n8n gemini agents intelligence artificielle" },
        { title: "Filtrer : SIG & Géomatique (PostGIS, LIDAR)", icon: "🗺️", cat: "Actions", meta: "Filtre", action: () => filterByDomain('sig'), keywords: "sig gis postgis qgis lidar ign geomatique spatial" },
        { title: "Copier Email (lionel.atty@gmail.com)", icon: "✉️", cat: "Actions", meta: "Contact", action: () => { navigator.clipboard.writeText('lionel.atty@gmail.com'); alert('Email copié dans le presse-papier !'); }, keywords: "email mail contact lionel atty" },
        { title: "Copier Téléphone (+33 6 01 59 00 23)", icon: "📞", cat: "Actions", meta: "Contact", action: () => { navigator.clipboard.writeText('+33 6 01 59 00 23'); alert('Téléphone copié !'); }, keywords: "telephone phone portable tel contact" },
        { title: "Télécharger le PDF haute fidélité Typst", icon: "📥", cat: "Actions", meta: "Livrable", action: () => { window.location.href = PDF_URL; }, keywords: "download telecharger pdf typst resume cv" },
        { title: "Imprimer le CV au format A4", icon: "🖨️", cat: "Actions", meta: "Print", action: () => window.print(), keywords: "print imprimer a4 papier" },
        { title: "Changer de thème (Sombre / Clair)", icon: "🌓", cat: "Actions", meta: "Thème", action: () => toggleTheme(), keywords: "theme sombre clair dark light mode nuit jour" },
      ];
      actions.forEach(a => idx.push({ ...a, score: 0 }));

      // B. Experiences
      RESUME_DATA.experiences.forEach(exp => {
        const fullContent = [exp.company, exp.role, exp.summary, exp.dates, exp.location, ...exp.bullets, ...exp.tags, ...(exp.pipeline || [])].join(" ");
        idx.push({
          title: `${exp.company} — ${exp.role}`,
          subtitle: `${exp.dates} &bull; ${exp.summary.substring(0, 100)}...`,
          icon: "💼",
          cat: "Expériences",
          meta: exp.dates,
          keywords: fullContent,
          action: () => {
            switchMainView('web');
            filterByDomain('all');
            setTimeout(() => {
              const el = document.getElementById(`exp-${exp.id}`);
              if (el) {
                el.classList.add('highlight');
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => el.classList.remove('highlight'), 3000);
              }
            }, 100);
          }
        });
      });

      // C. Projects & Talks
      RESUME_DATA.projects_and_talks.forEach((proj, i) => {
        const fullContent = [proj.title, proj.category, proj.description, proj.dates, ...proj.tags].join(" ");
        idx.push({
          title: proj.title,
          subtitle: `${proj.category} (${proj.dates}) — ${proj.description.substring(0, 95)}...`,
          icon: "🚀",
          cat: "Projets & Talks",
          meta: proj.dates,
          keywords: fullContent,
          action: () => {
            switchMainView('web');
            filterByDomain('all');
            setTimeout(() => {
              const el = document.getElementById(`proj-${i+1}`);
              if (el) {
                el.classList.add('highlight');
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => el.classList.remove('highlight'), 3000);
              }
            }, 100);
          }
        });
      });

      // D. Skills Categories & Individual Techs
      RESUME_DATA.skills_categories.forEach((cat, i) => {
        idx.push({
          title: cat.title,
          subtitle: cat.tags.join(" &bull; "),
          icon: "🛠️",
          cat: "Compétences",
          meta: "Stack",
          keywords: cat.title + " " + cat.tags.join(" "),
          action: () => {
            switchMainView('web');
            filterByDomain('all');
            setTimeout(() => {
              const el = document.getElementById(`skill-${i+1}`);
              if (el) {
                el.classList.add('highlight');
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => el.classList.remove('highlight'), 3000);
              }
            }, 100);
          }
        });

        // Index each tag individually
        cat.tags.forEach(tag => {
          idx.push({
            title: `Techno : ${tag}`,
            subtitle: `Catégorie : ${cat.title}`,
            icon: "🏷️",
            cat: "Technologies",
            meta: "Tag",
            keywords: tag + " " + cat.title,
            action: () => filterByTech(tag)
          });
        });
      });

      // E. Education & Research
      RESUME_DATA.education.forEach(edu => {
        const pubText = edu.publication ? `${edu.publication.title} ${edu.publication.journal} ${edu.publication.authors}` : "";
        idx.push({
          title: `${edu.degree} (${edu.institution})`,
          subtitle: `${edu.dates} &bull; ${edu.description}`,
          icon: "🎓",
          cat: "Formation & Recherche",
          meta: edu.dates,
          keywords: `${edu.degree} ${edu.institution} ${edu.description} ${pubText}`,
          action: () => {
            switchMainView('web');
            filterByDomain('all');
          }
        });
      });

      // Attach synonyms indexer
      idx.forEach(item => {
        let kwLower = item.keywords.toLowerCase();
        for (const [key, synList] of Object.entries(SYNONYMS)) {
          if (kwLower.includes(key)) {
            kwLower += " " + synList.join(" ");
          }
        }
        item._normalizedKeywords = kwLower;
      });

      return idx;
    }

    // Levenshtein distance for typo tolerance
    function levenshteinDistance(s1, s2) {
      s1 = s1.toLowerCase();
      s2 = s2.toLowerCase();
      const costs = [];
      for (let i = 0; i <= s1.length; i++) {
        let lastValue = i;
        for (let j = 0; j <= s2.length; j++) {
          if (i === 0) costs[j] = j;
          else if (j > 0) {
            let newValue = costs[j - 1];
            if (s1.charAt(i - 1) !== s2.charAt(j - 1)) {
              newValue = Math.min(Math.min(newValue, lastValue), costs[j]) + 1;
            }
            costs[j - 1] = lastValue;
            lastValue = newValue;
          }
        }
        if (i > 0) costs[s2.length] = lastValue;
      }
      return costs[s2.length];
    }

    // 2. Smart Fuzzy Match & Scoring Function
    function performSmartSearch(query) {
      if (!query || !query.trim()) {
        return searchIndex.filter(i => i.cat === "Actions").slice(0, 8);
      }
      const rawQ = query.toLowerCase().trim();
      const qTokens = rawQ.split(/\s+/).filter(Boolean);

      const results = [];

      searchIndex.forEach(item => {
        const titleLower = item.title.toLowerCase();
        const kwLower = item._normalizedKeywords;
        const allText = `${titleLower} ${kwLower}`;
        let score = 0;

        // Exact match
        if (titleLower.includes(rawQ)) score += 100;
        if (kwLower.includes(rawQ)) score += 50;

        // Token match & Fuzzy match
        for (const t of qTokens) {
          if (titleLower.includes(t)) {
            score += 40;
          } else if (kwLower.includes(t)) {
            score += 20;
          } else if (t.length >= 3) {
            // Check fuzzy Levenshtein on all individual words
            const words = allText.split(/[\s\-_\/,\.:;()]+/);
            for (const w of words) {
              if (w.length >= 3) {
                if (w.startsWith(t) || t.startsWith(w)) {
                  score += 15;
                  break;
                }
                if (t.length >= 4 && w.length >= 4 && levenshteinDistance(t, w) <= 2) {
                  score += 10;
                  break;
                }
              }
            }
          }
        }

        if (score > 0) {
          if (item.cat === "Technologies" && titleLower.includes(rawQ)) score += 20;
          if (item.cat === "Expériences" && titleLower.includes(rawQ)) score += 15;
          results.push({ item, score });
        }
      });

      // Sort by highest score first
      results.sort((a, b) => b.score - a.score);
      return results.map(r => r.item);
    }

    // 3. Palette UI Functions
    function openPalette() {
      if (searchIndex.length === 0) {
        searchIndex = buildSearchIndex();
      }
      const p = document.getElementById('cmdPalette');
      p.classList.add('active');
      const input = document.getElementById('paletteSearchInput');
      input.value = '';
      input.focus();
      selectedPaletteIndex = 0;
      handlePaletteSearch('');
    }

    function closePalette() {
      document.getElementById('cmdPalette').classList.remove('active');
    }

    function handlePaletteBackdrop(e) {
      if (e.target.id === 'cmdPalette') closePalette();
    }

    function handlePaletteSearch(val) {
      currentPaletteResults = performSmartSearch(val);
      selectedPaletteIndex = 0;
      renderPaletteResults(currentPaletteResults, val);
    }

    function highlightText(text, query) {
      if (!query || !text) return text;
      const q = query.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${q})`, 'gi');
      return text.replace(regex, '<mark>$1</mark>');
    }

    function renderPaletteResults(items, query) {
      const container = document.getElementById('paletteResults');
      container.innerHTML = '';

      if (items.length === 0) {
        container.innerHTML = `
          <div class="palette-empty">
            <p>Aucun résultat pour "<strong>${query}</strong>"</p>
            <p style="font-size:0.78rem; color:var(--text-dim); margin-top:0.3rem;">Essayez un des termes populaires ci-dessous :</p>
            <div class="palette-suggestions">
              <span class="filter-chip" onclick="document.getElementById('paletteSearchInput').value='LLM'; handlePaletteSearch('LLM');">🤖 LLM</span>
              <span class="filter-chip" onclick="document.getElementById('paletteSearchInput').value='Vulkan'; handlePaletteSearch('Vulkan');">🎮 Vulkan</span>
              <span class="filter-chip" onclick="document.getElementById('paletteSearchInput').value='Python'; handlePaletteSearch('Python');">🐍 Python</span>
              <span class="filter-chip" onclick="document.getElementById('paletteSearchInput').value='FastAPI'; handlePaletteSearch('FastAPI');">⚡ FastAPI</span>
              <span class="filter-chip" onclick="document.getElementById('paletteSearchInput').value='Docker'; handlePaletteSearch('Docker');">🐳 Docker</span>
              <span class="filter-chip" onclick="document.getElementById('paletteSearchInput').value='PostGIS'; handlePaletteSearch('PostGIS');">🗺️ PostGIS</span>
            </div>
          </div>
        `;
        return;
      }

      // Group items by category
      const groups = {};
      items.forEach((it, idx) => {
        if (!groups[it.cat]) groups[it.cat] = [];
        groups[it.cat].push({ it, globalIdx: idx });
      });

      for (const [catName, list] of Object.entries(groups)) {
        const grpTitle = document.createElement('div');
        grpTitle.className = 'palette-group-header';
        grpTitle.innerText = `${catName} (${list.length})`;
        container.appendChild(grpTitle);

        list.forEach(({ it, globalIdx }) => {
          const div = document.createElement('div');
          div.className = 'palette-item' + (globalIdx === selectedPaletteIndex ? ' selected' : '');
          div.setAttribute('data-idx', globalIdx);
          div.innerHTML = `
            <div class="palette-item-left">
              <span class="palette-item-icon">${it.icon || '▸'}</span>
              <div class="palette-item-text">
                <div class="palette-item-title">${highlightText(it.title, query)}</div>
                ${it.subtitle ? `<div class="palette-item-desc">${highlightText(it.subtitle, query)}</div>` : ''}
              </div>
            </div>
            <span class="item-meta">${it.meta || ''}</span>
          `;
          div.onclick = () => {
            it.action();
            closePalette();
          };
          div.onmouseenter = () => {
            selectedPaletteIndex = globalIdx;
            updatePaletteSelection();
          };
          container.appendChild(div);
        });
      }
    }

    function updatePaletteSelection() {
      const items = document.querySelectorAll('.palette-item');
      items.forEach(el => {
        const idx = parseInt(el.getAttribute('data-idx'));
        el.classList.toggle('selected', idx === selectedPaletteIndex);
        if (idx === selectedPaletteIndex) {
          el.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    // Keyboard navigation in palette
    document.addEventListener('keydown', (e) => {
      const p = document.getElementById('cmdPalette');
      const isPaletteOpen = p.classList.contains('active');

      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (isPaletteOpen) closePalette();
        else openPalette();
        return;
      }

      if (e.key === 'Escape') {
        if (isPaletteOpen) {
          closePalette();
          return;
        }
        closeMediaModal();
        closeImageModal();
      }

      if (isPaletteOpen) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (currentPaletteResults.length > 0) {
            selectedPaletteIndex = (selectedPaletteIndex + 1) % currentPaletteResults.length;
            updatePaletteSelection();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (currentPaletteResults.length > 0) {
            selectedPaletteIndex = (selectedPaletteIndex - 1 + currentPaletteResults.length) % currentPaletteResults.length;
            updatePaletteSelection();
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (currentPaletteResults.length > 0 && currentPaletteResults[selectedPaletteIndex]) {
            currentPaletteResults[selectedPaletteIndex].action();
            closePalette();
          }
        }
        return;
      }

      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'v' || e.key === 'V') switchMainView(currentMainView === 'doc' ? 'web' : 'doc');
      if (e.key === 't' || e.key === 'T') toggleTheme();
      if (e.key === 'p' || e.key === 'P') window.print();
    });

    // 4. PDF.js ISO Renderer
    async function loadPDF() {
      try {
        pdfDoc = await pdfjsLib.getDocument(PDF_URL).promise;
        await renderDocPages();
      } catch (err) {
        console.error('PDF.js loading failed', err);
      }
    }

    async function renderDocPage(pageNum, canvasId, textLayerId) {
      if (!pdfDoc) return;
      const page = await pdfDoc.getPage(pageNum);
      const canvas = document.getElementById(canvasId);
      const ctx = canvas.getContext('2d');
      const textLayerDiv = document.getElementById(textLayerId);

      const unscaledViewport = page.getViewport({ scale: 1.0 });
      const targetWidth = 840;
      const scaleFactor = targetWidth / unscaledViewport.width;
      const viewport = page.getViewport({ scale: scaleFactor });

      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.floor(viewport.width * dpr);
      canvas.height = Math.floor(viewport.height * dpr);
      canvas.style.width = Math.floor(viewport.width) + 'px';
      canvas.style.height = Math.floor(viewport.height) + 'px';

      await page.render({
        canvasContext: ctx,
        viewport: viewport,
        transform: [dpr, 0, 0, dpr, 0, 0]
      }).promise;

      if (textLayerDiv) {
        textLayerDiv.innerHTML = '';
        textLayerDiv.style.width = Math.floor(viewport.width) + 'px';
        textLayerDiv.style.height = Math.floor(viewport.height) + 'px';
        const textContent = await page.getTextContent();
        pdfjsLib.renderTextLayer({
          textContent: textContent,
          container: textLayerDiv,
          viewport: viewport,
          textDivs: []
        });
      }
    }

    async function renderDocPages() {
      await renderDocPage(1, 'canvasPage1', 'textLayer1');
      await renderDocPage(2, 'canvasPage2', 'textLayer2');
    }

    function setDocMode(mode) {
      docMode = mode;
      const wrapper = document.getElementById('pagesWrapper');
      wrapper.className = 'pages-wrapper mode-' + mode;

      document.querySelectorAll('.doc-btn').forEach(b => b.classList.remove('active'));
      if (mode === 'single') document.getElementById('btnModeSingle').classList.add('active');
      if (mode === 'dual') document.getElementById('btnModeDual').classList.add('active');
      if (mode === 'continuous') document.getElementById('btnModeContinuous').classList.add('active');

      if (mode === 'single') {
        updateDocSingle();
      } else {
        document.getElementById('pageContainer1').classList.add('active');
        document.getElementById('pageContainer2').classList.add('active');
      }
    }

    function toggleDocSingle() {
      if (docMode !== 'single') {
        setDocMode('single');
      } else {
        docPageNum = docPageNum === 1 ? 2 : 1;
        updateDocSingle();
      }
    }

    function updateDocSingle() {
      document.getElementById('pageContainer1').classList.toggle('active', docPageNum === 1);
      document.getElementById('pageContainer2').classList.toggle('active', docPageNum === 2);
      document.getElementById('lblPageNum').innerText = `Page ${docPageNum}/2`;
    }

    function zoomDoc(delta) {
      docZoom = Math.min(Math.max(0.5, docZoom + delta), 2.2);
      document.getElementById('pagesWrapper').style.transform = `scale(${docZoom})`;
      document.getElementById('lblZoom').innerText = `${Math.round(docZoom * 100)}%`;
    }

    // 5. View Switcher (Document ↔ Interactive Web)
    function switchMainView(view) {
      currentMainView = view;
      const vDoc = document.getElementById('viewDocument');
      const vWeb = document.getElementById('viewInteractive');
      const tabDoc = document.getElementById('tabDoc');
      const tabWeb = document.getElementById('tabWeb');

      if (view === 'doc') {
        vDoc.style.display = 'flex';
        vWeb.style.display = 'none';
        tabDoc.classList.add('active');
        tabWeb.classList.remove('active');
      } else {
        vDoc.style.display = 'none';
        vWeb.style.display = 'block';
        tabDoc.classList.remove('active');
        tabWeb.classList.add('active');
      }
    }

    function goToMediaSection() {
      switchMainView('web');
      filterByDomain('all');
      setTimeout(() => {
        const el = document.getElementById('section-projects');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }

    // 6. Domain & Tech Filtering
    function filterByDomain(domain) {
      activeDomainFilter = domain;
      document.querySelectorAll('.filter-chip').forEach(c => {
        c.classList.toggle('active', c.getAttribute('data-domain') === domain);
      });

      if (currentMainView !== 'web') {
        switchMainView('web');
      }

      document.querySelectorAll('.exp-card').forEach(card => {
        const domains = (card.getAttribute('data-domains') || '').split(',');
        const match = (domain === 'all' || domains.includes(domain));
        card.style.display = match ? 'block' : 'none';
      });

      document.querySelectorAll('.project-card').forEach(card => {
        const d = card.getAttribute('data-domain');
        const match = (domain === 'all' || d === domain);
        card.style.display = match ? 'flex' : 'none';
      });

      document.querySelectorAll('.skill-block').forEach(card => {
        const d = card.getAttribute('data-domain');
        const match = (domain === 'all' || d === domain);
        card.style.display = match ? 'block' : 'none';
      });
    }

    function filterByTech(techName) {
      if (currentMainView !== 'web') {
        switchMainView('web');
      }
      const lower = techName.toLowerCase();
      document.querySelectorAll('.tech-tag').forEach(t => {
        t.classList.toggle('active', t.innerText.toLowerCase() === lower);
      });

      document.querySelectorAll('.exp-card').forEach(card => {
        const tags = Array.from(card.querySelectorAll('.tech-tag')).map(t => t.innerText.toLowerCase());
        const hasTag = tags.some(t => t.includes(lower));
        card.classList.toggle('highlight', hasTag);
        if (hasTag) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    // 7. Media & Image Modals
    function openMediaModal(url, title) {
      document.getElementById('mediaModalTitle').innerText = title;
      document.getElementById('mediaModalFrame').src = url;
      document.getElementById('mediaModal').classList.add('active');
    }

    function closeMediaModal() {
      document.getElementById('mediaModal').classList.remove('active');
      document.getElementById('mediaModalFrame').src = '';
    }

    function openImageModal(src, title) {
      document.getElementById('imageModalTitle').innerText = title || 'Aperçu Image';
      document.getElementById('imageModalImg').src = src;
      document.getElementById('imageModal').classList.add('active');
    }

    function closeImageModal() {
      document.getElementById('imageModal').classList.remove('active');
      document.getElementById('imageModalImg').src = '';
    }

    function switchCardMedia(cardIdx, src, label, btn) {
      const img = document.getElementById(`media-img-${cardIdx}`);
      const badge = document.getElementById(`media-badge-${cardIdx}`);
      if (img) img.src = src;
      if (badge) badge.innerText = src.endsWith('.gif') ? '🔥 DÉMO ANIMÉE' : '📸 ' + label.toUpperCase();

      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('.media-thumb-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
    }

    // 8. Theme Toggle
    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.classList.contains('dark');
      if (isDark) {
        html.classList.remove('dark');
        html.classList.add('light');
        document.getElementById('iconSun').style.display = 'block';
        document.getElementById('iconMoon').style.display = 'none';
        localStorage.setItem('cv_theme', 'light');
      } else {
        html.classList.remove('light');
        html.classList.add('dark');
        document.getElementById('iconSun').style.display = 'none';
        document.getElementById('iconMoon').style.display = 'block';
        localStorage.setItem('cv_theme', 'dark');
      }
    }

    // Init
    (function init() {
      if (localStorage.getItem('cv_theme') === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        document.getElementById('iconSun').style.display = 'block';
        document.getElementById('iconMoon').style.display = 'none';
      }
      searchIndex = buildSearchIndex();
      loadPDF();
    })();
  </script>
</body>
</html>
